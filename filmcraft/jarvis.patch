 /// Keep each selected identity once, then expand linked partners when linked selection is on.
+// Jarvis: time of the last Add Edit in each sequence, for Add Edit and Select.
+static JARVIS_LAST_CUT: std::sync::Mutex<Option<(String, Tick)>> = std::sync::Mutex::new(None);
+
+fn jarvis_note_cut(s: &Session, t: Tick) {
+    let key = format!("{:?}", s.state.active_sequence);
+    if let Ok(mut g) = JARVIS_LAST_CUT.lock() {
+        *g = Some((key, t));
+    }
+}
+
+fn jarvis_prev_cut(s: &Session) -> Option<Tick> {
+    let key = format!("{:?}", s.state.active_sequence);
+    JARVIS_LAST_CUT.lock().ok().and_then(|g| g.as_ref().filter(|(k, _)| *k == key).map(|(_, t)| *t))
+}
