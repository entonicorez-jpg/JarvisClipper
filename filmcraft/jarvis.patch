diff --git a/crates/ui-egui/src/jarvis_ui.rs b/crates/ui-egui/src/jarvis_ui.rs
new file mode 100644
index 0000000..ea1a38d
--- /dev/null
+++ b/crates/ui-egui/src/jarvis_ui.rs
@@ -0,0 +1,191 @@
+//! Jarvis Composer: finestra con sottotitoli animati, transizioni ed effetti (FilmCraft Jarvis).
+
+use serde_json::{Value, json};
+
+use crate::FilmcraftApp;
+use filmcraft_engine::jarvis::{CLIP_FX, STYLES, TRANSITIONS};
+
+pub(crate) struct State {
+    pub open: bool,
+    style: usize,
+    /// 0 = quante ne usa lo stile
+    words: u32,
+    upper: bool,
+    censor: bool,
+    pop: bool,
+    y: f32,
+    size: f32,
+    precise: bool,
+    retranscribe: bool,
+    scope: usize,
+    amount: f32,
+    msg: String,
+    /// comando da eseguire al prossimo frame (così il messaggio "attendi" si vede prima)
+    pending: Option<(String, Value, bool)>,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            open: false,
+            style: 0,
+            words: 0,
+            upper: true,
+            censor: true,
+            pop: true,
+            y: 0.0,
+            size: 100.0,
+            precise: true,
+            retranscribe: false,
+            scope: 0,
+            amount: 1.0,
+            msg: String::new(),
+            pending: None,
+        }
+    }
+}
+
+const SCOPES: [(&str, &str); 3] = [("playhead", "Taglio vicino all'indicatore"), ("selection", "Clip selezionate"), ("all", "Tutti i tagli (V1)")];
+
+pub(crate) fn toggle(app: &mut FilmcraftApp) {
+    app.jarvis_ui.open = !app.jarvis_ui.open;
+}
+
+pub(crate) fn show(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    // esegue il comando in attesa (al secondo frame, dopo aver mostrato "attendi")
+    if let Some((cmd, p, armed)) = app.jarvis_ui.pending.take() {
+        if armed {
+            let r = crate::menus::invoke(app, ctx, &cmd, p);
+            app.jarvis_ui.msg = match r {
+                Ok(v) => done_msg(&cmd, &v),
+                Err(e) => format!("⚠ {e}"),
+            };
+        } else {
+            app.jarvis_ui.pending = Some((cmd, p, true));
+            ctx.request_repaint();
+        }
+    }
+    if !app.jarvis_ui.open {
+        return;
+    }
+    let mut open = true;
+    let mut run: Option<(String, Value, String)> = None;
+    let st = &mut app.jarvis_ui;
+    egui::Window::new("Jarvis Composer")
+        .open(&mut open)
+        .resizable(false)
+        .default_width(360.0)
+        .default_pos(ctx.content_rect().right_top() + egui::vec2(-400.0, 80.0))
+        .show(ctx, |ui| {
+            ui.heading("🔤 Sottotitoli animati");
+            egui::ComboBox::from_id_salt("jarvis_style").width(220.0).selected_text(STYLES[st.style.min(STYLES.len() - 1)].name).show_ui(ui, |ui| {
+                for (i, s) in STYLES.iter().enumerate() {
+                    ui.selectable_value(&mut st.style, i, s.name);
+                }
+            });
+            ui.horizontal(|ui| {
+                ui.label("Parole per volta");
+                ui.add(egui::Slider::new(&mut st.words, 0..=6).custom_formatter(|v, _| if v == 0.0 { "auto".into() } else { format!("{v}") }));
+            });
+            ui.horizontal(|ui| {
+                ui.checkbox(&mut st.upper, "MAIUSCOLO");
+                ui.checkbox(&mut st.pop, "Pop");
+                ui.checkbox(&mut st.censor, "Censura parolacce");
+            });
+            ui.horizontal(|ui| {
+                ui.label("Altezza");
+                ui.add(egui::Slider::new(&mut st.y, 0.0..=95.0).custom_formatter(|v, _| if v == 0.0 { "auto".into() } else { format!("{v:.0}%") }));
+            });
+            ui.horizontal(|ui| {
+                ui.label("Grandezza");
+                ui.add(egui::Slider::new(&mut st.size, 40.0..=200.0).suffix("%"));
+            });
+            ui.horizontal(|ui| {
+                ui.checkbox(&mut st.precise, "Trascrizione precisa");
+                ui.checkbox(&mut st.retranscribe, "Ritrascrivi");
+            });
+            if ui.add_sized([ui.available_width(), 30.0], egui::Button::new("✨ Crea sottotitoli")).clicked() {
+                let mut p = json!({
+                    "style": STYLES[st.style.min(STYLES.len() - 1)].id, "upper": st.upper, "pop": st.pop, "censor": st.censor,
+                    "size": st.size, "model": if st.precise { "whisper-small" } else { "whisper-base" }, "language": "it",
+                    "retranscribe": st.retranscribe,
+                });
+                if st.words > 0 {
+                    p["words"] = json!(st.words);
+                }
+                if st.y > 0.0 {
+                    p["y"] = json!(st.y / 100.0);
+                }
+                run = Some((
+                    "jarvis.autoCaptions".into(),
+                    p,
+                    "⏳ Trascrivo e creo i sottotitoli… (la prima volta scarica il modello: FilmCraft resta fermo qualche minuto)".into(),
+                ));
+            }
+            ui.small("Finiscono sulla traccia \"Sottotitoli Jarvis\": ogni pezzo si modifica come un testo normale.");
+            ui.separator();
+
+            ui.heading("🎬 Transizioni");
+            egui::ComboBox::from_id_salt("jarvis_scope").width(220.0).selected_text(SCOPES[st.scope].1).show_ui(ui, |ui| {
+                for (i, (_, n)) in SCOPES.iter().enumerate() {
+                    ui.selectable_value(&mut st.scope, i, *n);
+                }
+            });
+            egui::Grid::new("jarvis_tr").num_columns(3).spacing([6.0, 6.0]).show(ui, |ui| {
+                let mut k = 0;
+                for tp in TRANSITIONS.iter().map(|t| (t.id, t.name)).chain(std::iter::once(("mix", "🎲 Mix casuale"))) {
+                    if ui.add_sized([108.0, 26.0], egui::Button::new(tp.1)).clicked() {
+                        run = Some(("jarvis.transition".into(), json!({"preset": tp.0, "scope": SCOPES[st.scope].0}), String::new()));
+                    }
+                    k += 1;
+                    if k % 3 == 0 {
+                        ui.end_row();
+                    }
+                }
+            });
+            ui.separator();
+
+            ui.heading("💥 Effetti sulla clip");
+            ui.horizontal(|ui| {
+                ui.label("Intensità");
+                ui.add(egui::Slider::new(&mut st.amount, 0.3..=2.5));
+            });
+            ui.horizontal_wrapped(|ui| {
+                for (id, name) in CLIP_FX {
+                    if ui.button(*name).clicked() {
+                        run = Some(("jarvis.clipFx".into(), json!({"preset": id, "amount": st.amount}), String::new()));
+                    }
+                }
+            });
+            ui.small("Vale per le clip selezionate, o per quella sotto l'indicatore.");
+            if !st.msg.is_empty() {
+                ui.separator();
+                ui.label(&st.msg);
+            }
+        });
+    if !open {
+        app.jarvis_ui.open = false;
+    }
+    if let Some((cmd, p, wait)) = run {
+        if wait.is_empty() {
+            let r = crate::menus::invoke(app, ctx, &cmd, p);
+            app.jarvis_ui.msg = match r {
+                Ok(v) => done_msg(&cmd, &v),
+                Err(e) => format!("⚠ {e}"),
+            };
+        } else {
+            app.jarvis_ui.msg = wait;
+            app.jarvis_ui.pending = Some((cmd, p, false));
+            ctx.request_repaint();
+        }
+    }
+}
+
+fn done_msg(cmd: &str, v: &Value) -> String {
+    match cmd {
+        "jarvis.autoCaptions" => format!("✅ Creati {} pezzi di sottotitoli", v["captions"].as_u64().unwrap_or(0)),
+        "jarvis.transition" => format!("✅ Transizioni messe: {}", v["transitions"].as_u64().unwrap_or(0)),
+        "jarvis.clipFx" => format!("✅ Effetto applicato a {} clip", v["clips"].as_u64().unwrap_or(0)),
+        _ => "✅ Fatto".into(),
+    }
+}
