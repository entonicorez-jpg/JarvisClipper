+fn thumb(st: &mut State, ctx: &egui::Context, p: &std::path::Path) -> Option<egui::TextureHandle> {
+    if let Some(t) = st.thumbs.get(p) {
+        return t.clone();
+    }
+    let tex = std::fs::read(p).ok().and_then(|b| image::load_from_memory(&b).ok()).map(|img| {
+        let img = img.thumbnail(320, 180).to_rgba8();
+        let ci = egui::ColorImage::from_rgba_unmultiplied([img.width() as usize, img.height() as usize], &img);
+        ctx.load_texture(format!("jarvis-mh-{}", p.display()), ci, egui::TextureOptions::LINEAR)
+    });
+    st.thumbs.insert(p.to_path_buf(), tex.clone());
+    tex
+}
