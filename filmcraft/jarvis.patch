+// ---------------------------------------------------------------- transizioni stile Composer
+// Animazioni a keyframe sulle due clip del taglio (fine di quella prima, inizio di quella dopo),
+// su tutte le tracce video: Trasforma con motion blur (otturatore), Offset per gli slide senza bordi
+// neri, blur direzionale che picca sul taglio.
+
+pub const COMPOSER: &[(&str, &str)] = &[
+    ("c_zoom_in", "Zoom In"),
+    ("c_zoom_spin", "Zoom + Spin"),
+    ("c_slide_left", "Slide ←"),
+    ("c_slide_right", "Slide →"),
+    ("c_slide_up", "Slide ↑"),
+    ("c_slide_down", "Slide ↓"),
+    ("c_whip", "Whip veloce"),
+    ("c_glitch", "Glitch RGB"),
+    ("c_impact", "Impatto (shake)"),
+    ("c_mix", "🎲 Mix Composer"),
+];
+
+const C_MIX: &[&str] = &["c_zoom_in", "c_slide_left", "c_zoom_spin", "c_slide_up", "c_whip", "c_slide_right"];
+
+fn kf(p: &mut Param, t: Tick, v: ParamValue, interp: Interpolation) {
+    p.put_keyframe(t, v);
+    if let Ok(i) = p.keyframes.binary_search_by_key(&t, |k| k.time) {
+        p.keyframes[i].interp = interp;
+        p.keyframes[i].out_influence = 0.7;
+        p.keyframes[i].in_influence = 0.7;
+    }
+}
+
+/// (da, a) su una clip: lato A = ultimi `n` fotogrammi (accelera), lato B = primi `n` (rallenta).
+/// I keyframe degli effetti sono in tempo della sorgente: `base` = inizio della clip nella sorgente.
+fn anim(p: &mut Param, side_a: bool, base: Tick, dur: Tick, n: Tick, from: ParamValue, to: ParamValue) {
+    if side_a {
+        let t0 = Tick(base.0 + (dur.0 - n.0).max(0));
+        kf(p, t0, from, Interpolation::EaseOut);
+        kf(p, Tick(base.0 + dur.0), to, Interpolation::Linear);
+    } else {
+        kf(p, base, from, Interpolation::Linear);
+        kf(p, Tick(base.0 + n.min(dur).0), to, Interpolation::EaseIn);
+    }
+}
+
+fn fx_instance(id: &str) -> Option<filmcraft_project::EffectInstance> {
+    filmcraft_project::find_effect(id).map(|d| d.instance())
+}
+
+fn composer_one(it: &mut filmcraft_project::TrackItem, preset: &str, side_a: bool, n: Tick, w: f64, h: f64) {
+    let dur = it.duration;
+    let base = it.source_in;
+    let c = Vec2::new(w / 2.0, h / 2.0);
+    let f = |v: f64| ParamValue::Float(v);
+    let pt = |x: f64, y: f64| ParamValue::Vec2(Vec2::new(x, y));
+    let blur = |it: &mut filmcraft_project::TrackItem, angle: f64, peak: f64| {
+        if let Some(mut e) = fx_instance("directional_blur") {
+            e.params.insert("direction".into(), Param::new(f(angle)));
+            let mut l = Param::new(f(0.0));
+            anim(&mut l, side_a, base, dur, n, f(if side_a { 0.0 } else { peak }), f(if side_a { peak } else { 0.0 }));
+            e.params.insert("length".into(), l);
+            it.effects.push(e);
+        }
+    };
+    match preset {
+        "c_zoom_in" | "c_zoom_spin" => {
+            let Some(mut e) = fx_instance("transform") else { return };
+            e.params.insert("position".into(), Param::new(ParamValue::Vec2(c)));
+            e.params.insert("anchor".into(), Param::new(ParamValue::Vec2(c)));
+            e.params.insert("shutter_override".into(), Param::new(ParamValue::Bool(true)));
+            e.params.insert("shutter_angle".into(), Param::new(f(360.0)));
+            let mut sc = Param::new(f(100.0));
+            if side_a { anim(&mut sc, true, base, dur, n, f(100.0), f(320.0)) } else { anim(&mut sc, false, base, dur, n, f(320.0), f(100.0)) }
+            e.params.insert("scale_height".into(), sc.clone());
+            e.params.insert("scale_width".into(), sc);
+            if preset == "c_zoom_spin" {
+                let mut r = Param::new(f(0.0));
+                if side_a { anim(&mut r, true, base, dur, n, f(0.0), f(35.0)) } else { anim(&mut r, false, base, dur, n, f(-35.0), f(0.0)) }
+                e.params.insert("rotation".into(), r);
+            }
+            it.effects.push(e);
+        }
+        "c_slide_left" | "c_slide_right" | "c_slide_up" | "c_slide_down" | "c_whip" => {
+            let (dx, dy, ang) = match preset {
+                "c_slide_left" | "c_whip" => (-w, 0.0, 90.0),
+                "c_slide_right" => (w, 0.0, 90.0),
+                "c_slide_up" => (0.0, -h, 0.0),
+                _ => (0.0, h, 0.0),
+            };
+            let Some(mut e) = fx_instance("offset") else { return };
+            let mut sp = Param::new(ParamValue::Vec2(c));
+            // A esce di mezzo schermo, B entra dall'altro mezzo: insieme fanno uno slide continuo
+            if side_a {
+                anim(&mut sp, true, base, dur, n, pt(c.x, c.y), pt(c.x + dx / 2.0, c.y + dy / 2.0));
+            } else {
+                anim(&mut sp, false, base, dur, n, pt(c.x - dx / 2.0, c.y - dy / 2.0), pt(c.x, c.y));
+            }
+            e.params.insert("shift".into(), sp);
+            it.effects.push(e);
+            blur(it, ang, if preset == "c_whip" { 260.0 } else { 160.0 });
+        }
+        "c_glitch" => {
+            if let Some(mut e) = fx_instance("rgb_split") {
+                let mut a = Param::new(f(0.0));
+                anim(&mut a, side_a, base, dur, n, f(if side_a { 0.0 } else { 60.0 }), f(if side_a { 60.0 } else { 0.0 }));
+                e.params.insert("amount".into(), a);
+                it.effects.push(e);
+            }
+            blur(it, 90.0, 60.0);
+        }
+        "c_impact" => {
+            if !side_a {
+                if let Some(mut e) = fx_instance("camera_shake") {
+                    let mut a = Param::new(f(0.0));
+                    kf(&mut a, base, f(80.0), Interpolation::Linear);
+                    kf(&mut a, Tick(base.0 + (n.0 * 2).min(dur.0)), f(0.0), Interpolation::EaseIn);
+                    e.params.insert("amount".into(), a);
+                    e.params.insert("motion_blur".into(), Param::new(ParamValue::Bool(true)));
+                    it.effects.push(e);
+                }
+                let Some(mut t) = fx_instance("transform") else { return };
+                t.params.insert("position".into(), Param::new(ParamValue::Vec2(c)));
+                t.params.insert("anchor".into(), Param::new(ParamValue::Vec2(c)));
+                let mut sc = Param::new(f(100.0));
+                anim(&mut sc, false, base, dur, n, f(118.0), f(108.0));
+                t.params.insert("scale_height".into(), sc.clone());
+                t.params.insert("scale_width".into(), sc);
+                it.effects.push(t);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Gli istanti dei tagli su cui lavorare.
+fn cut_times(s: &Session, scope: &str) -> Vec<Tick> {
+    let Some(q) = s.active_sequence() else { return Vec::new() };
+    let mut ts: Vec<Tick> = edit_points(s, scope).iter().filter_map(|c| q.find_item(*c).map(|(_, i)| i.end())).collect();
+    ts.sort();
+    ts.dedup();
+    ts
+}
+
+fn composer(s: &mut Session, p: &Value) -> Result<Value> {
+    let pid = str_p(p, "preset").unwrap_or("c_zoom_in").to_string();
+    let scope = str_p(p, "scope").unwrap_or("playhead").to_string();
+    let times = cut_times(s, &scope);
+    if times.is_empty() {
+        return Err(bad("jarvis.composer", "nessun taglio qui: metti l'indicatore su un taglio o seleziona le clip"));
+    }
+    let rate = s.sequence_rate();
+    let frames = u64_p(p, "frames").map(|v| v.clamp(2, 30) as i64).unwrap_or(if pid == "c_whip" { 4 } else { 7 });
+    let n = Tick(rate.frame_duration().0 * frames);
+    let (w, h) = s.active_sequence().map(|q| (q.settings.width as f64, q.settings.height as f64)).unwrap_or((1920.0, 1080.0));
+    let done = s.edit_sequence("Transizione Jarvis", |q, _ctx, _st| {
+        let mut done = 0;
+        for (k, t) in times.iter().enumerate() {
+            let preset = if pid == "c_mix" { C_MIX[k % C_MIX.len()] } else { pid.as_str() };
+            for tr in q.video_tracks.iter_mut().filter(|tr| tr.name != CAPTION_TRACK) {
+                for it in tr.items.iter_mut() {
+                    if it.end() == *t {
+                        composer_one(it, preset, true, n, w, h);
+                    } else if it.start == *t {
+                        composer_one(it, preset, false, n, w, h);
+                    }
+                }
+            }
+            done += 1;
+        }
+        Ok(done)
+    })?;
+    let mut sfx = 0;
+    if bool_p(p, "sfx").unwrap_or(true) {
+        let sounds: Vec<_> = times
+            .iter()
+            .enumerate()
+            .filter_map(|(k, t)| {
+                let preset = if pid == "c_mix" { C_MIX[k % C_MIX.len()] } else { pid.as_str() };
+                let f = pick_sfx(sfx_kind(preset)?, k)?;
+                Some((f, Tick((t.0 - n.0).max(0))))
+            })
+            .collect();
+        sfx = place_sfx(s, sounds, f64_p(p, "sfxGain").unwrap_or(-3.0))?;
+    }
+    Ok(json!({"transitions": done, "sfx": sfx}))
+}
