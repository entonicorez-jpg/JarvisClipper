+// ---------------------------------------------------------------- aggiornamento di FilmCraft Jarvis
+
+const REPO: &str = "entonicorez-jpg/JarvisClipper";
+
+fn exe_dir() -> Option<std::path::PathBuf> {
+    std::env::current_exe().ok().and_then(|e| e.parent().map(|p| p.to_path_buf()))
+}
+
+fn current_tag() -> Option<String> {
+    let d = exe_dir()?;
+    for f in [d.join("jarvis_tag.txt"), d.parent()?.join("jarvis_tag.txt")] {
+        if let Ok(t) = std::fs::read_to_string(&f) {
+            let t = t.trim().to_string();
+            if !t.is_empty() {
+                return Some(t);
+            }
+        }
+    }
+    None
+}
+
+#[cfg(windows)]
+fn hidden(cmd: &mut std::process::Command) {
+    use std::os::windows::process::CommandExt;
+    cmd.creation_flags(0x0800_0000);
+}
+#[cfg(not(windows))]
+fn hidden(_: &mut std::process::Command) {}
+
+fn check_update(slot: std::sync::Arc<std::sync::Mutex<Option<(String, String)>>>, ctx: egui::Context) {
+    let Some(cur) = current_tag() else { return };
+    let url = format!("https://api.github.com/repos/{REPO}/releases?per_page=100");
+    let mut cmd = std::process::Command::new("powershell");
+    cmd.args(["-NoProfile", "-Command", &format!("[Net.ServicePointManager]::SecurityProtocol='Tls12'; (Invoke-WebRequest -UseBasicParsing -Headers @{{'User-Agent'='FilmCraftJarvis'}} '{url}').Content")]);
+    hidden(&mut cmd);
+    let Ok(out) = cmd.output() else { return };
+    let Ok(v) = serde_json::from_slice::<Value>(&out.stdout) else { return };
+    let best = v
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|r| r["tag_name"].as_str().is_some_and(|t| t.starts_with("filmcraft-jarvis-")) && !r["draft"].as_bool().unwrap_or(false))
+        .max_by(|a, b| a["published_at"].as_str().unwrap_or("").cmp(b["published_at"].as_str().unwrap_or("")));
+    let Some(r) = best else { return };
+    let tag = r["tag_name"].as_str().unwrap_or("").to_string();
+    let asset = r["assets"].as_array().into_iter().flatten().find(|a| a["name"].as_str().is_some_and(|n| n.ends_with(".zip")));
+    if let (false, Some(a)) = (tag == cur, asset) {
+        if let (Ok(mut g), Some(u)) = (slot.lock(), a["browser_download_url"].as_str()) {
+            *g = Some((tag, u.to_string()));
+        }
+        ctx.request_repaint();
+    }
+}
+
+fn start_update(tag: &str, url: &str) -> Result<(), String> {
+    let dest = exe_dir().ok_or("cartella del programma sconosciuta")?;
+    let exe = std::env::current_exe().map_err(|e| e.to_string())?;
+    let script = std::env::temp_dir().join("filmcraft_jarvis_update.ps1");
+    let body = r#"param($url, $tag, $dest, $procId, $exe)
+try { Wait-Process -Id $procId -Timeout 600 -ErrorAction SilentlyContinue } catch {}
+[Net.ServicePointManager]::SecurityProtocol = 'Tls12'
+$zip = Join-Path $env:TEMP 'FilmCraftJarvis_update.zip'
+Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $zip
+$tmp = Join-Path $env:TEMP 'FilmCraftJarvis_update'
+Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
+Expand-Archive -Path $zip -DestinationPath $tmp -Force
+$inner = Get-ChildItem $tmp -Directory | Select-Object -First 1
+$src = if ($inner) { $inner.FullName } else { $tmp }
+Remove-Item (Join-Path $src 'portable.txt') -ErrorAction SilentlyContinue
+for ($i = 0; $i -lt 20; $i++) { try { Copy-Item -Path (Join-Path $src '*') -Destination $dest -Recurse -Force -ErrorAction Stop; break } catch { Start-Sleep -Seconds 1 } }
+Set-Content -Path (Join-Path $dest 'jarvis_tag.txt') -Value $tag
+$parent = Split-Path $dest -Parent
+if ((Split-Path $parent -Leaf) -eq 'FilmCraftJarvis') { Set-Content -Path (Join-Path $parent 'jarvis_tag.txt') -Value $tag }
+Remove-Item $zip -ErrorAction SilentlyContinue
+Start-Process -FilePath $exe
+"#;
+    std::fs::write(&script, body).map_err(|e| e.to_string())?;
+    let mut cmd = std::process::Command::new("powershell");
+    cmd.args(["-NoProfile", "-ExecutionPolicy", "Bypass", "-WindowStyle", "Hidden", "-File"])
+        .arg(&script)
+        .args(["-url", url, "-tag", tag, "-dest"])
+        .arg(&dest)
+        .args(["-procId", &std::process::id().to_string(), "-exe"])
+        .arg(&exe);
+    hidden(&mut cmd);
+    cmd.spawn().map_err(|e| e.to_string())?;
+    Ok(())
+}
+
+fn update_banner(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let st = &mut app.jarvis_ui;
+    if !st.upd_checked {
+        st.upd_checked = true;
+        if cfg!(windows) {
+            let slot = st.upd.clone();
+            let c = ctx.clone();
+            std::thread::spawn(move || check_update(slot, c));
+        }
+    }
+    if st.upd_dismissed {
+        return;
+    }
+    let Some((tag, url)) = st.upd.lock().ok().and_then(|g| g.clone()) else { return };
+    let mut close = false;
+    egui::Area::new(egui::Id::new("jarvis_update_banner"))
+        .anchor(egui::Align2::CENTER_TOP, egui::vec2(0.0, 44.0))
+        .order(egui::Order::Foreground)
+        .show(ctx, |ui| {
+            egui::Frame::popup(ui.style()).fill(egui::Color32::from_rgb(76, 46, 140)).show(ui, |ui| {
+                ui.horizontal(|ui| {
+                    ui.label(egui::RichText::new("🦉 C'è una nuova versione di FilmCraft Jarvis").color(egui::Color32::WHITE).strong());
+                    if ui.button("⬇ Aggiorna").clicked() {
+                        match start_update(&tag, &url) {
+                            Ok(()) => ctx.send_viewport_cmd(egui::ViewportCommand::Close),
+                            Err(e) => app.jarvis_ui.msg = format!("⚠ Aggiornamento: {e}"),
+                        }
+                    }
+                    if ui.button("Dopo").clicked() {
+                        close = true;
+                    }
+                });
+                ui.small(egui::RichText::new("FilmCraft si chiude (salva prima!), si aggiorna e si riapre da solo.").color(egui::Color32::from_gray(225)));
+            });
+        });
+    if close {
+        app.jarvis_ui.upd_dismissed = true;
+    }
+}
