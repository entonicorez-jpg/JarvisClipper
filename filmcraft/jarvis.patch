+/// Trascinamento di una transizione Composer: l'etichetta segue il mouse, al rilascio sulla
+/// Timeline si applica sul taglio più vicino.
+fn composer_drag(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let Some((name, base)) = app.jarvis_ui.mh_drag.clone() else { return };
+    let (down, released, pos) = ctx.input(|i| (i.pointer.primary_down(), i.pointer.primary_released(), i.pointer.latest_pos()));
+    if let Some(p) = pos {
+        egui::Area::new(egui::Id::new("jarvis_mh_drag")).fixed_pos(p + egui::vec2(14.0, 14.0)).order(egui::Order::Tooltip).show(ctx, |ui| {
+            egui::Frame::popup(ui.style()).show(ui, |ui| {
+                ui.label(format!("🎞 {name}"));
+            });
+        });
+    }
+    if released || !down {
+        app.jarvis_ui.mh_drag = None;
+        let (Some(p), Some(r)) = (pos, app.last_timeline_rect) else { return };
+        if !r.contains(p) {
+            return;
+        }
+        let secs = app.ui.timeline.scroll + (p.x - r.min.x) as f64 / app.ui.timeline.pps;
+        let mut params = base;
+        params["time"] = json!(filmcraft_time::Tick::from_seconds_f64(secs.max(0.0)).0);
+        let res = crate::menus::invoke(app, ctx, "jarvis.composerItem", params);
+        app.jarvis_ui.msg = match res {
+            Ok(v) => done_msg("jarvis.composerItem", &v),
+            Err(e) => format!("⚠ {e}"),
+        };
+    } else {
+        ctx.request_repaint();
+    }
+}
