+// ---------------------------------------------------------------- anteprime sottotitoli
+
+fn c32(c: [f32; 4]) -> egui::Color32 {
+    egui::Color32::from_rgba_unmultiplied((c[0] * 255.0) as u8, (c[1] * 255.0) as u8, (c[2] * 255.0) as u8, (c[3] * 255.0) as u8)
+}
+
+/// (scala, rotazione°, spostamento verticale in "altezze", opacità) dell'animazione dopo `sec` secondi:
+/// gli stessi keyframe che mette il motore, a 30 fps.
+fn anim_at(anim: &str, sec: f64, tilt: f32) -> (f32, f32, f32, f32) {
+    let fr = (sec * 30.0) as f32;
+    let lerp = |ks: &[(f32, f32)]| -> f32 {
+        if fr <= ks[0].0 {
+            return ks[0].1;
+        }
+        for w in ks.windows(2) {
+            if fr <= w[1].0 {
+                let u = (fr - w[0].0) / (w[1].0 - w[0].0);
+                let u = u * u * (3.0 - 2.0 * u);
+                return w[0].1 + (w[1].1 - w[0].1) * u;
+            }
+        }
+        ks[ks.len() - 1].1
+    };
+    match anim {
+        "pop" => (lerp(&[(0.0, 55.0), (3.0, 112.0), (6.0, 100.0)]) / 100.0, tilt, 0.0, 1.0),
+        "pop_osc" => (
+            lerp(&[(0.0, 45.0), (3.0, 116.0), (6.0, 95.0), (8.0, 102.0), (10.0, 100.0)]) / 100.0,
+            tilt + lerp(&[(0.0, -9.0), (3.0, 6.0), (6.0, -3.5), (9.0, 1.5), (12.0, 0.0)]),
+            0.0,
+            1.0,
+        ),
+        "pop_su" => (
+            lerp(&[(0.0, 40.0), (4.0, 112.0), (7.0, 97.0), (9.0, 100.0)]) / 100.0,
+            tilt,
+            lerp(&[(0.0, 0.7), (4.0, -0.1), (7.0, 0.03), (9.0, 0.0)]),
+            lerp(&[(0.0, 0.0), (2.0, 1.0)]),
+        ),
+        "rimbalzo" => (1.0, tilt, lerp(&[(0.0, 0.55), (4.0, -0.12), (7.0, 0.04), (9.0, 0.0)]), lerp(&[(0.0, 0.0), (3.0, 1.0)])),
+        "scivola" => (1.0, tilt, lerp(&[(0.0, 0.4), (5.0, 0.0)]), lerp(&[(0.0, 0.0), (4.0, 1.0)])),
+        "tremolio" => {
+            let ph = (fr / 4.0) as i32;
+            let u = (fr / 4.0).fract();
+            let a = if ph % 2 == 0 { 2.5 } else { -2.5 };
+            let r = a + (-a - a) * (u * u * (3.0 - 2.0 * u));
+            (lerp(&[(0.0, 55.0), (3.0, 112.0), (6.0, 100.0)]) / 100.0, tilt + r, 0.0, 1.0)
+        }
+        "zoom" => (0.9 + 0.18 * (sec as f32 / 1.4).min(1.0), tilt, 0.0, 1.0),
+        _ => (1.0, tilt, 0.0, 1.0),
+    }
+}
+
+/// Disegna un sottotitolo con lo stile (contorno, riquadro, parola evidenziata) centrato in `c`.
+fn paint_caption(p: &egui::Painter, sd: &CapStyle, c: egui::Pos2, size: f32, words: &[&str], hl: usize, anim: (f32, f32, f32, f32)) {
+    let (sc, rot, dy, alpha) = anim;
+    let size = (size * sc).max(2.0);
+    let c = c + egui::vec2(0.0, dy * size);
+    let fid = egui::FontId::proportional(size);
+    let mk = |over: Option<egui::Color32>| {
+        let mut job = egui::text::LayoutJob::default();
+        for (i, w) in words.iter().enumerate() {
+            let col = over.unwrap_or_else(|| if !sd.highlight.is_empty() && i == hl { c32(sd.highlight[0]) } else { c32(sd.fill) });
+            let txt = if i + 1 < words.len() { format!("{w} ") } else { w.to_string() };
+            job.append(&txt, 0.0, egui::TextFormat { font_id: fid.clone(), color: col.gamma_multiply(alpha), ..Default::default() });
+        }
+        p.layout_job(job)
+    };
+    let main = mk(None);
+    let half = main.size() / 2.0;
+    let ang = rot.to_radians();
+    if let Some((bc, op)) = sd.boxed {
+        let r = egui::Rect::from_center_size(c, main.size() + egui::vec2(size * 0.5, size * 0.25));
+        p.rect_filled(r, size * 0.22, c32(bc).gamma_multiply(op / 100.0 * alpha));
+    }
+    let put = |g: std::sync::Arc<egui::Galley>, off: egui::Vec2| {
+        // ruota attorno al centro del testo
+        let (s, co) = ang.sin_cos();
+        let v = egui::vec2(-half.x, -half.y);
+        let rv = egui::vec2(v.x * co - v.y * s, v.x * s + v.y * co);
+        p.add(egui::epaint::TextShape::new(c + rv + off, g, egui::Color32::WHITE).with_angle(ang));
+    };
+    if sd.shadow {
+        put(mk(Some(egui::Color32::from_black_alpha((150.0 * alpha) as u8))), egui::vec2(size * 0.05, size * 0.07));
+    }
+    if let Some(sc) = sd.stroke {
+        let w = (size * sd.stroke_w * 0.7).max(1.2);
+        let g = mk(Some(c32(sc).gamma_multiply(alpha)));
+        for k in 0..8 {
+            let a = k as f32 * std::f32::consts::FRAC_PI_4;
+            put(g.clone(), egui::vec2(a.cos() * w, a.sin() * w));
+        }
+    }
+    put(main, egui::Vec2::ZERO);
+}
+
+fn style_card(ui: &mut egui::Ui, sd: &CapStyle, selected: bool, t: f64, anim: &str, tilt: bool) -> egui::Response {
+    let (rect, resp) = ui.allocate_exact_size(egui::vec2(124.0, 86.0), egui::Sense::click());
+    let p = ui.painter_at(rect);
+    let bg = if resp.hovered() { egui::Color32::from_rgb(52, 52, 60) } else { egui::Color32::from_rgb(34, 34, 40) };
+    p.rect_filled(rect, 6.0, bg);
+    let stroke = if selected { egui::Stroke::new(2.0, egui::Color32::from_rgb(120, 90, 255)) } else { egui::Stroke::new(1.0, egui::Color32::from_gray(60)) };
+    p.rect_stroke(rect, 6.0, stroke, egui::StrokeKind::Inside);
+    // ciclo: parola nuova ogni 0.7 s
+    let words: &[&str] = if sd.words == 1 { &["CHE", "ROBA", "RAGA"] } else { &["CHE", "ROBA", "RAGA"] };
+    let cyc = 0.7;
+    let k = (t / cyc) as usize;
+    let sec = t % cyc;
+    let tl = if tilt { if k % 2 == 0 { -3.0 } else { 3.0 } } else { 0.0 };
+    let shown: Vec<&str> = if sd.words == 1 { vec![words[k % words.len()]] } else { words[..2.min(sd.words).max(2)].to_vec() };
+    let hl = if sd.words == 1 { 0 } else { k % shown.len() };
+    let a = if sd.words == 1 || k % shown.len() == 0 { anim_at(anim, sec, tl) } else { anim_at("nessuna", 0.0, tl) };
+    let txt: Vec<String> = shown.iter().map(|w| if sd.upper { w.to_string() } else { w.to_lowercase() }).collect();
+    let refs: Vec<&str> = txt.iter().map(String::as_str).collect();
+    paint_caption(&p, sd, rect.center() - egui::vec2(0.0, 8.0), 19.0, &refs, hl, a);
+    p.text(rect.center_bottom() - egui::vec2(0.0, 5.0), egui::Align2::CENTER_BOTTOM, sd.name, egui::FontId::proportional(10.5), egui::Color32::from_gray(200));
+    resp.on_hover_text(sd.name)
+}
+
+/// Riquadro 9:16 dove si clicca/trascina per decidere dove vanno i sottotitoli.
+fn position_picker(ui: &mut egui::Ui, st: &mut State, t: f64) {
+    let (rect, resp) = ui.allocate_exact_size(egui::vec2(117.0, 208.0), egui::Sense::click_and_drag());
+    let p = ui.painter_at(rect);
+    p.rect_filled(rect, 4.0, egui::Color32::from_rgb(28, 28, 34));
+    // finta cam sopra e gioco sotto, come i tuoi short
+    let cam = egui::Rect::from_min_size(rect.min, egui::vec2(rect.width(), rect.height() * 0.36));
+    p.rect_filled(cam, 4.0, egui::Color32::from_rgb(58, 46, 90));
+    p.text(cam.center(), egui::Align2::CENTER_CENTER, "CAM", egui::FontId::proportional(11.0), egui::Color32::from_gray(160));
+    p.text(egui::pos2(rect.center().x, rect.min.y + rect.height() * 0.9), egui::Align2::CENTER_CENTER, "GIOCO", egui::FontId::proportional(11.0), egui::Color32::from_gray(90));
+    p.rect_stroke(rect, 4.0, egui::Stroke::new(1.0, egui::Color32::from_gray(80)), egui::StrokeKind::Inside);
+    if let Some(pos) = resp.interact_pointer_pos() {
+        if resp.dragged() || resp.clicked() {
+            st.x = (((pos.x - rect.min.x) / rect.width()) * 100.0).clamp(8.0, 92.0).round();
+            st.y = (((pos.y - rect.min.y) / rect.height()) * 100.0).clamp(6.0, 94.0).round();
+        }
+    }
+    let y = if st.y <= 0.0 { 66.0 } else { st.y };
+    let c = egui::pos2(rect.min.x + rect.width() * st.x / 100.0, rect.min.y + rect.height() * y / 100.0);
+    let sd = &STYLES[st.style.min(STYLES.len() - 1)];
+    let cyc = 0.7;
+    let a = anim_at(ANIMS[st.anim.min(ANIMS.len() - 1)].0, t % cyc, if st.tilt { if (t / cyc) as usize % 2 == 0 { -3.0 } else { 3.0 } } else { 0.0 });
+    paint_caption(&p, sd, c, 17.0 * st.size / 100.0, &[if sd.upper { "CIAO" } else { "ciao" }], 0, a);
+    p.line_segment([egui::pos2(rect.min.x, c.y), egui::pos2(rect.max.x, c.y)], egui::Stroke::new(0.5, egui::Color32::from_rgba_unmultiplied(120, 90, 255, 90)));
+}
+
+/// I tratti della timeline coperti dalle clip selezionate (senza i sottotitoli), uniti, in tick.
+fn selected_ranges(s: &filmcraft_engine::Session) -> Vec<(i64, i64)> {
+    let Some(q) = s.active_sequence() else { return Vec::new() };
+    let sel = &s.state.selection;
+    if sel.is_empty() {
+        return Vec::new();
+    }
+    let mut r: Vec<(i64, i64)> = q
+        .video_tracks
+        .iter()
+        .filter(|t| t.name != filmcraft_engine::jarvis::CAPTION_TRACK)
+        .chain(q.audio_tracks.iter())
+        .flat_map(|t| t.items.iter())
+        .filter(|it| sel.contains(&it.id))
+        .map(|it| (it.start.0, it.end().0))
+        .collect();
+    r.sort();
+    let mut out: Vec<(i64, i64)> = Vec::new();
+    for (a, b) in r {
+        match out.last_mut() {
+            Some(l) if a <= l.1 => l.1 = l.1.max(b),
+            _ => out.push((a, b)),
+        }
+    }
+    out
+}
