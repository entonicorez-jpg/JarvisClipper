+// ---------------------------------------------------------------- sottotitoli in background
+
+fn start_captions(app: &mut FilmcraftApp, ctx: &egui::Context, p: Value) {
+    match filmcraft_engine::jarvis::prepare_captions(&app.session, &p) {
+        Ok(None) => {
+            let r = crate::menus::invoke(app, ctx, "jarvis.autoCaptions", p);
+            app.jarvis_ui.msg = match r {
+                Ok(v) => done_msg("jarvis.autoCaptions", &v),
+                Err(e) => format!("⚠ {e}"),
+            };
+        }
+        Ok(Some(job)) => {
+            let prog = std::sync::Arc::new(std::sync::Mutex::new((0.0f32, "Preparo l'audio…".to_string())));
+            let pr2 = prog.clone();
+            let c2 = ctx.clone();
+            let handle = std::thread::spawn(move || {
+                let cb = move |f: f32, m: String| {
+                    if let Ok(mut g) = pr2.lock() {
+                        *g = (f, m);
+                    }
+                    c2.request_repaint();
+                };
+                filmcraft_engine::jarvis::run_captions(job, &cb)
+            });
+            app.jarvis_ui.msg.clear();
+            app.jarvis_ui.cap = Some(CapRun { handle, prog, params: p });
+        }
+        Err(e) => app.jarvis_ui.msg = format!("⚠ {e}"),
+    }
+}
+
+fn poll_captions(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let finished = app.jarvis_ui.cap.as_ref().is_some_and(|c| c.handle.is_finished());
+    if !finished {
+        if app.jarvis_ui.cap.is_some() {
+            ctx.request_repaint_after(std::time::Duration::from_millis(300));
+        }
+        return;
+    }
+    let Some(run) = app.jarvis_ui.cap.take() else { return };
+    let res = run.handle.join().unwrap_or_else(|_| Err("la trascrizione si è interrotta".into()));
+    match res {
+        Ok(done) => {
+            if let Err(e) = filmcraft_engine::jarvis::apply_transcripts(&mut app.session, done) {
+                app.jarvis_ui.msg = format!("⚠ {e}");
+                return;
+            }
+            let mut p = run.params;
+            p["retranscribe"] = json!(false);
+            let r = crate::menus::invoke(app, ctx, "jarvis.autoCaptions", p);
+            app.jarvis_ui.msg = match r {
+                Ok(v) => done_msg("jarvis.autoCaptions", &v),
+                Err(e) => format!("⚠ {e}"),
+            };
+        }
+        Err(e) => app.jarvis_ui.msg = format!("⚠ {e}"),
+    }
+}
