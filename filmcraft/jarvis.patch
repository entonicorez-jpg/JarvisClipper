+//! Jarvis Composer: sottotitoli animati stile AutoCut, preset di transizioni ed effetti sulle clip
+//! (FilmCraft Jarvis, build di JarvisClipper). Comandi `jarvis.*`.
+
+use serde_json::{Value, json};
+
+use filmcraft_edit::transcript::SeqWord;
+use filmcraft_project::graphic::{TEXT_LAYER, ensure_layer_uids, new_text_layer};
+use filmcraft_project::{CharStyle, ClipId, LayerExtra, Param, ParamValue, StyleRun, Track, TrackId, TrackKind};
+use filmcraft_project::keyframe::Interpolation;
+use filmcraft_geom::Vec2;
+use filmcraft_time::{Tick, TimeRange};
+
+use crate::commands::{CommandSpec, bad, bool_p, f64_p, has_seq, str_p, u64_p};
+use crate::{EngineError, Result, Session};
+
+type Run = fn(&mut Session, &Value) -> Result<Value>;
+
+fn spec(id: &'static str, label: &'static str, params: &'static str, run: Run) -> CommandSpec {
+    CommandSpec {
+        id,
+        label,
+        menu: &["Sequence", "Jarvis"],
+        shortcut: None,
+        params,
+        enabled: has_seq,
+        run,
+        journal: true,
+        named: crate::commands::NamedKeys::NONE,
+    }
+}
+
+pub const CAPTION_TRACK: &str = "Sottotitoli Jarvis";
+
+// ---------------------------------------------------------------- stili dei sottotitoli
+
+#[derive(Clone, Copy)]
+pub struct CapStyle {
+    pub id: &'static str,
+    pub name: &'static str,
+    pub font: &'static str,
+    pub font_style: &'static str,
+    pub fill: [f32; 4],
+    /// Colori della parola detta (a turno); vuoto = nessuna evidenziazione.
+    pub highlight: &'static [[f32; 4]],
+    /// Ingrandimento della parola detta (1 = uguale).
+    pub hl_size: f32,
+    pub stroke: Option<[f32; 4]>,
+    pub stroke_w: f32,
+    pub shadow: bool,
+    /// (colore, opacità %) del riquadro dietro al testo.
+    pub boxed: Option<([f32; 4], f32)>,
+    pub words: usize,
+    pub upper: bool,
+    pub pop: bool,
+}
+
+const WHITE: [f32; 4] = [1.0, 1.0, 1.0, 1.0];
+const BLACK: [f32; 4] = [0.0, 0.0, 0.0, 1.0];
+const YELLOW: [f32; 4] = [1.0, 0.84, 0.04, 1.0];
+const GREEN: [f32; 4] = [0.22, 1.0, 0.35, 1.0];
+const RED: [f32; 4] = [1.0, 0.18, 0.22, 1.0];
+const CYAN: [f32; 4] = [0.2, 0.85, 1.0, 1.0];
+const PURPLE: [f32; 4] = [0.66, 0.42, 1.0, 1.0];
+
+pub const STYLES: &[CapStyle] = &[
+    CapStyle { id: "jarvis", name: "Jarvis (giallo)", font: "Arial Black", font_style: "Regular", fill: WHITE, highlight: &[YELLOW], hl_size: 1.0,
+        stroke: Some(BLACK), stroke_w: 0.13, shadow: true, boxed: None, words: 3, upper: true, pop: true },
+    CapStyle { id: "hormozi", name: "Hormozi (verde)", font: "Arial Black", font_style: "Regular", fill: WHITE, highlight: &[GREEN], hl_size: 1.15,
+        stroke: Some(BLACK), stroke_w: 0.14, shadow: true, boxed: None, words: 3, upper: true, pop: true },
+    CapStyle { id: "parola", name: "Una parola alla volta", font: "Arial Black", font_style: "Regular", fill: WHITE, highlight: &[], hl_size: 1.0,
+        stroke: Some(BLACK), stroke_w: 0.14, shadow: true, boxed: None, words: 1, upper: true, pop: true },
+    CapStyle { id: "beast", name: "Beast (giallo + rosso)", font: "Arial Black", font_style: "Regular", fill: YELLOW, highlight: &[RED], hl_size: 1.1,
+        stroke: Some(BLACK), stroke_w: 0.16, shadow: true, boxed: None, words: 2, upper: true, pop: true },
+    CapStyle { id: "box", name: "Riquadro bianco", font: "Arial", font_style: "Bold", fill: BLACK, highlight: &[RED], hl_size: 1.0,
+        stroke: None, stroke_w: 0.0, shadow: false, boxed: Some((WHITE, 100.0)), words: 3, upper: false, pop: true },
+    CapStyle { id: "neon", name: "Neon viola", font: "Arial Black", font_style: "Regular", fill: WHITE, highlight: &[PURPLE], hl_size: 1.08,
+        stroke: Some([0.16, 0.0, 0.3, 1.0]), stroke_w: 0.12, shadow: true, boxed: None, words: 3, upper: true, pop: true },
+    CapStyle { id: "minimal", name: "Minimal", font: "Inter", font_style: "Bold", fill: WHITE, highlight: &[], hl_size: 1.0,
+        stroke: None, stroke_w: 0.0, shadow: true, boxed: None, words: 5, upper: false, pop: false },
+];
+
+/// Il font dei sottotitoli di base (quello dei TikTok); se manca si usa quello dello stile.
+pub const DEFAULT_FONT: &str = "Provicali";
+
+/// Se `family` è installato.
+pub fn font_installed(family: &str) -> bool {
+    !family.trim().is_empty() && !filmcraft_text::fonts::resolve(family.trim(), "Regular").missing
+}
+
+/// (famiglia, stile) da usare: quello chiesto se c'è, altrimenti quello dello stile, poi Arial Black.
+fn pick_font(want: &str, st: &CapStyle) -> (String, String) {
+    let want = want.trim();
+    if !want.is_empty() && (want.eq_ignore_ascii_case(st.font) || font_installed(want)) {
+        let style = if want.eq_ignore_ascii_case(st.font) { st.font_style } else { "Regular" };
+        return (want.to_string(), style.to_string());
+    }
+    if font_installed(st.font) {
+        return (st.font.to_string(), st.font_style.to_string());
+    }
+    if font_installed("Arial Black") {
+        return ("Arial Black".into(), "Regular".into());
+    }
+    ("Inter".into(), "Bold".into())
+}
+
+pub fn style(id: &str) -> &'static CapStyle {
+    STYLES.iter().find(|s| s.id == id).unwrap_or(&STYLES[0])
+}
+
+// ---------------------------------------------------------------- parolacce
+
+const SWEARS: &[&str] = &[
+    "cazz", "minchi", "merd", "stronz", "vaffancul", "fancul", "puttan", "troi", "coglion", "bastard", "figa", "fica", "incazz",
+    "porcodio", "porcamadonna", "diocane", "dioporco", "madonnaputtana", "fuck", "shit", "bitch",
+];
+
+fn norm(w: &str) -> String {
+    w.to_lowercase().chars().filter(|c| c.is_alphanumeric()).collect()
+}
+
+fn is_swear(w: &str) -> bool {
+    let n = norm(w);
+    n.len() >= 3 && SWEARS.iter().any(|s| n.starts_with(s)) && !matches!(n.as_str(), "figata" | "figate" | "figo" | "fighi" | "fico")
+}
+
+/// "cazzo" -> "c***o"
+fn mask(w: &str) -> String {
+    let cs: Vec<char> = w.chars().collect();
+    let letters: Vec<usize> = (0..cs.len()).filter(|&i| cs[i].is_alphanumeric()).collect();
+    if letters.len() < 3 {
+        return w.to_string();
+    }
+    let (a, b) = (letters[0], letters[letters.len() - 1]);
+    cs.iter().enumerate().map(|(i, c)| if i > a && i < b && c.is_alphanumeric() { '*' } else { *c }).collect()
+}
+
+// ---------------------------------------------------------------- raggruppamento
+
+fn clean(w: &str, upper: bool) -> String {
+    let t = w.trim();
+    let t: String = t.trim_matches(|c: char| matches!(c, '.' | ',' | ';' | ':' | '"' | '«' | '»' | '…')).to_string();
+    if upper { t.to_uppercase() } else { t }
+}
+
+/// Gruppi di parole: si spezza a `n` parole, a `max_chars`, sulle pause e dopo la punteggiatura.
+fn groups(words: &[SeqWord], n: usize, max_chars: usize) -> Vec<Vec<usize>> {
+    let pause = Tick::from_seconds_f64(0.45);
+    let mut out: Vec<Vec<usize>> = Vec::new();
+    let mut cur: Vec<usize> = Vec::new();
+    let mut chars = 0usize;
+    for (i, w) in words.iter().enumerate() {
+        let len = w.text.trim().chars().count();
+        let gap = cur.last().map(|&j| w.start - words[j].end > pause).unwrap_or(false);
+        if !cur.is_empty() && (cur.len() >= n || chars + 1 + len > max_chars || gap) {
+            out.push(std::mem::take(&mut cur));
+            chars = 0;
+        }
+        chars += len + usize::from(!cur.is_empty());
+        cur.push(i);
+        let t = w.text.trim_end();
+        if n > 1 && (t.ends_with('.') || t.ends_with('?') || t.ends_with('!')) {
+            out.push(std::mem::take(&mut cur));
+            chars = 0;
+        }
+    }
+    if !cur.is_empty() {
+        out.push(cur);
+    }
+    out
+}
+
+fn color(v: [f32; 4]) -> ParamValue {
+    ParamValue::Color(v)
+}
+
+fn setp(e: &mut filmcraft_project::EffectInstance, k: &str, v: ParamValue) {
+    e.params.insert(k.to_string(), Param::new(v));
+}
+
+/// Il livello di testo di un pezzo di sottotitolo.
+/// Animazioni dei sottotitoli: (id, nome).
+pub const ANIMS: &[(&str, &str)] = &[
+    ("pop_osc", "Pop + oscillazione"),
+    ("pop", "Pop"),
+    ("pop_su", "Pop dal basso (salta su)"),
+    ("rimbalzo", "Rimbalzo dal basso"),
+    ("scivola", "Scivola su"),
+    ("tremolio", "Pop + tremolio continuo"),
+    ("zoom", "Zoom lento"),
+    ("nessuna", "Nessuna"),
+];
+
+fn keys(e: &mut filmcraft_project::EffectInstance, name: &str, base: ParamValue, ks: &[(i64, ParamValue, Interpolation)], f: Tick) {
+    let mut p = Param::new(base);
+    for (fr, v, _) in ks {
+        p.put_keyframe(Tick(f.0 * fr), v.clone());
+    }
+    for k in &mut p.keyframes {
+        if let Some((_, _, it)) = ks.iter().find(|(fr, _, _)| Tick(f.0 * fr) == k.time) {
+            k.interp = *it;
+        }
+    }
+    e.params.insert(name.into(), p);
+}
+
+#[allow(clippy::too_many_arguments)]
+fn animate(e: &mut filmcraft_project::EffectInstance, anim: &str, entrance: bool, dur: Tick, tilt: f64, pos: Vec2, size: f64, rate: filmcraft_time::FrameRate) {
+    use Interpolation::{AutoBezier as S, EaseOut as O, Linear as L};
+    let f = rate.frame_duration();
+    let fl = |v: f64| ParamValue::Float(v);
+    let pt = |dy: f64| ParamValue::Vec2(Vec2::new(pos.x, pos.y + dy * size));
+    let frames = (dur.0 / f.0.max(1)).max(1);
+    if tilt != 0.0 {
+        setp(e, "rotation", fl(tilt));
+    }
+    match anim {
+        "pop" if entrance => keys(e, "scale", fl(100.0), &[(0, fl(55.0), O), (3, fl(112.0), O), (6, fl(100.0), O)], f),
+        "pop_osc" if entrance => {
+            // sbuca a pop e poi fa una leggera oscillazione prima di fermarsi
+            keys(e, "scale", fl(100.0), &[(0, fl(45.0), O), (3, fl(116.0), S), (6, fl(95.0), S), (8, fl(102.0), S), (10, fl(100.0), L)], f);
+            keys(e, "rotation", fl(tilt), &[(0, fl(tilt - 9.0), S), (3, fl(tilt + 6.0), S), (6, fl(tilt - 3.5), S), (9, fl(tilt + 1.5), S), (12, fl(tilt), L)], f);
+        }
+        "pop_su" if entrance => {
+            // salta su dal basso ingrandendosi, supera un filo e si assesta
+            keys(e, "scale", fl(100.0), &[(0, fl(40.0), O), (4, fl(112.0), S), (7, fl(97.0), S), (9, fl(100.0), L)], f);
+            keys(e, "position", pt(0.0), &[(0, pt(0.7), O), (4, pt(-0.1), S), (7, pt(0.03), S), (9, pt(0.0), L)], f);
+            keys(e, "opacity", fl(100.0), &[(0, fl(0.0), O), (2, fl(100.0), L)], f);
+        }
+        "rimbalzo" if entrance => {
+            keys(e, "position", pt(0.0), &[(0, pt(0.55), O), (4, pt(-0.12), S), (7, pt(0.04), S), (9, pt(0.0), L)], f);
+            keys(e, "opacity", fl(100.0), &[(0, fl(0.0), O), (3, fl(100.0), L)], f);
+        }
+        "scivola" if entrance => {
+            keys(e, "position", pt(0.0), &[(0, pt(0.4), O), (5, pt(0.0), L)], f);
+            keys(e, "opacity", fl(100.0), &[(0, fl(0.0), O), (4, fl(100.0), L)], f);
+        }
+        "tremolio" => {
+            if entrance {
+                keys(e, "scale", fl(100.0), &[(0, fl(55.0), O), (3, fl(112.0), O), (6, fl(100.0), O)], f);
+            }
+            let mut ks = Vec::new();
+            let mut fr = 0;
+            let mut sgn = 1.0;
+            while fr <= frames {
+                ks.push((fr, fl(tilt + 2.5 * sgn), S));
+                sgn = -sgn;
+                fr += 4;
+            }
+            if ks.len() > 1 {
+                keys(e, "rotation", fl(tilt), &ks, f);
+            }
+        }
+        "zoom" => keys(e, "scale", fl(100.0), &[(0, fl(if entrance { 90.0 } else { 100.0 }), L), (frames, fl(108.0), L)], f),
+        _ => {}
+    }
+}
+
+fn caption_layer(st: &CapStyle, font: &(String, String), text: &str, hl: Option<(std::ops::Range<usize>, [f32; 4])>, pos: Vec2, size: f64, anim: &str, entrance: bool, dur: Tick, tilt: f64, rate: filmcraft_time::FrameRate) -> filmcraft_project::EffectInstance {
+    let mut e = new_text_layer(text, pos, size);
+    setp(&mut e, "name", ParamValue::Text("Sottotitolo".into()));
+    setp(&mut e, "font", ParamValue::Text(font.0.clone()));
+    setp(&mut e, "font_style", ParamValue::Text(font.1.clone()));
+    setp(&mut e, "align", ParamValue::Choice(1));
+    setp(&mut e, "fill_color", color(st.fill));
+    if let Some(sc) = st.stroke {
+        setp(&mut e, "stroke", ParamValue::Bool(true));
+        setp(&mut e, "stroke_color", color(sc));
+        setp(&mut e, "stroke_width", ParamValue::Float(size * st.stroke_w as f64));
+        setp(&mut e, "stroke_type", ParamValue::Choice(0));
+    }
+    if st.shadow {
+        setp(&mut e, "shadow", ParamValue::Bool(true));
+        setp(&mut e, "shadow_opacity", ParamValue::Float(70.0));
+        setp(&mut e, "shadow_distance", ParamValue::Float(size * 0.06));
+        setp(&mut e, "shadow_blur", ParamValue::Float(size * 0.18));
+    }
+    if let Some((bc, op)) = st.boxed {
+        setp(&mut e, "background", ParamValue::Bool(true));
+        setp(&mut e, "background_color", color(bc));
+        setp(&mut e, "background_opacity", ParamValue::Float(op as f64));
+        setp(&mut e, "background_size", ParamValue::Float(size * 0.28));
+        setp(&mut e, "background_radius", ParamValue::Float(size * 0.22));
+    }
+    if let Some((r, c)) = hl {
+        let style = CharStyle { fill: Some(c), size: (st.hl_size != 1.0).then_some(size as f32 * st.hl_size), ..Default::default() };
+        e.layer = Some(Box::new(LayerExtra { uid: 0, runs: vec![StyleRun { start: r.start, end: r.end, style }], pin: None }));
+    }
+    animate(&mut e, anim, entrance, dur, tilt, pos, size, rate);
+    e
+}
+
+/// Le parole della sequenza; se non c'è la trascrizione la fa (scaricando il modello la prima volta).
+fn words_or_transcribe(s: &mut Session, p: &Value) -> Result<Vec<SeqWord>> {
+    let w = crate::transcript::sequence_words(s);
+    if !w.is_empty() && !bool_p(p, "retranscribe").unwrap_or(false) {
+        return Ok(w);
+    }
+    let model = str_p(p, "model").unwrap_or("whisper-small").to_string();
+    if let (Some(dir), Some(m)) = (crate::transcript::models_dir(), filmcraft_speech::models::find(&model)) {
+        if !filmcraft_speech::models::installed(&dir, m) {
+            s.execute("transcript.downloadModel", json!({"model": model}))?;
+        }
+    }
+    let lang = str_p(p, "language").unwrap_or("it").to_string();
+    s.execute("transcript.generate", json!({"model": model, "language": lang, "diarize": false}))?;
+    Ok(crate::transcript::sequence_words(s))
+}
+
+/// Jarvis: i tratti della timeline (`"ranges":[[a,b]]` in tick) a cui limitare i sottotitoli
+/// (le clip selezionate). None = tutta la sequenza.
+fn caption_ranges(p: &Value) -> Option<Vec<(Tick, Tick)>> {
+    let v: Vec<(Tick, Tick)> = p["ranges"].as_array()?.iter().filter_map(|r| Some((Tick(r[0].as_i64()?), Tick(r[1].as_i64()?)))).filter(|(a, b)| b > a).collect();
+    (!v.is_empty()).then_some(v)
+}
+
+fn in_ranges(r: &[(Tick, Tick)], t: Tick) -> bool {
+    r.iter().any(|(a, b)| t >= *a && t < *b)
+}
+
+fn auto_captions(s: &mut Session, p: &Value) -> Result<Value> {
+    let st = *style(str_p(p, "style").unwrap_or("jarvis"));
+    let ranges = caption_ranges(p);
+    let mut words = words_or_transcribe(s, p)?;
+    if let Some(r) = &ranges {
+        words.retain(|w| in_ranges(r, w.start));
+    }
+    if words.is_empty() {
+        return Err(EngineError::Other("nessuna parola trovata nell'audio della sequenza".into()));
+    }
+    let seq_id = s.state.active_sequence.ok_or(EngineError::NoSequence)?;
+    let (w, h, rate) = {
+        let q = s.active_sequence().ok_or(EngineError::NoSequence)?;
+        (q.settings.width, q.settings.height, q.settings.frame_rate)
+    };
+    let n = u64_p(p, "words").map(|v| v.clamp(1, 8) as usize).unwrap_or(st.words);
+    let upper = bool_p(p, "upper").unwrap_or(st.upper);
+    let censor = bool_p(p, "censor").unwrap_or(true);
+    let pop = bool_p(p, "pop").unwrap_or(st.pop);
+    let anim = str_p(p, "anim").map(str::to_string).unwrap_or_else(|| (if !pop { "nessuna" } else if st.words == 1 { "pop_osc" } else { "pop" }).to_string());
+    let tilt_on = bool_p(p, "tilt").unwrap_or(false);
+    let ypos = f64_p(p, "y").unwrap_or(if h > w { 0.66 } else { 0.8 }).clamp(0.05, 0.95);
+    let xpos = f64_p(p, "x").unwrap_or(0.5).clamp(0.05, 0.95);
+    let scale = f64_p(p, "size").unwrap_or(100.0).clamp(30.0, 300.0) / 100.0;
+    let size = (w.min(h) as f64) * if h > w { 0.085 } else { 0.082 } * scale;
+    let max_chars = if n == 1 { 40 } else { ((w as f64 * 0.86) / (size * 0.72)).max(8.0) as usize };
+    let pos = Vec2::new(w as f64 * xpos, h as f64 * ypos);
+    // quanto resta a schermo dopo l'ultima parola (poco: deve sparire quando hai finito di dirla)
+    let hold = Tick::from_seconds_f64(if n == 1 { 0.12 } else { 0.25 });
+    let bridge = Tick::from_seconds_f64(0.3);
+
+    let texts: Vec<String> = words.iter().map(|x| {
+        let t = clean(&x.text, upper);
+        if censor && is_swear(&t) { mask(&t) } else { t }
+    }).collect();
+    let gs = groups(&words, n, max_chars);
+
+    // pezzi: (inizio, fine, testo, evidenziazione, pop)
+    let mut pieces: Vec<(Tick, Tick, String, Option<(std::ops::Range<usize>, [f32; 4])>, bool, usize)> = Vec::new();
+    let mut color_i = 0usize;
+    for (gi, g) in gs.iter().enumerate() {
+        let gstart = words[g[0]].start;
+        let next = gs.get(gi + 1).map(|ng| words[ng[0]].start);
+        let gend_max = words[*g.last().unwrap_or(&g[0])].end + hold;
+        // se la frase dopo arriva subito, resta fino a lei (niente sfarfallio)
+        let gend = next.map_or(gend_max, |nx| if nx <= gend_max + bridge { nx } else { gend_max });
+        let parts: Vec<&str> = g.iter().map(|&i| texts[i].as_str()).collect();
+        let text = parts.join(" ");
+        let mut offs = Vec::new();
+        let mut c = 0usize;
+        for (k, t) in parts.iter().enumerate() {
+            if k > 0 {
+                c += 1;
+            }
+            offs.push(c..c + t.chars().count());
+            c += t.chars().count();
+        }
+        for (k, &i) in g.iter().enumerate() {
+            let a = if k == 0 { gstart } else { words[i].start };
+            let b = if k + 1 < g.len() { words[g[k + 1]].start } else { gend };
+            // una parola alla volta: finisce quando finisci di dirla (se la pausa è breve resta fino alla prossima)
+            let b = if n == 1 {
+                let end = words[i].end + hold;
+                match next {
+                    Some(nx) if nx <= end + bridge => nx,
+                    _ => end.min(b),
+                }
+            } else {
+                b
+            };
+            let hl = if st.highlight.is_empty() {
+                None
+            } else {
+                let col = st.highlight[color_i % st.highlight.len()];
+                if n == 1 {
+                    color_i += 1;
+                }
+                Some((offs[k].clone(), col))
+            };
+            pieces.push((a, b, text.clone(), hl, k == 0, gi));
+            if st.highlight.is_empty() {
+                // senza evidenziazione basta un pezzo per gruppo
+                pieces.last_mut().map(|x| x.1 = gend);
+                break;
+            }
+        }
+        if n > 1 {
+            color_i += 1;
+        }
+    }
+
+    let font = pick_font(str_p(p, "font").unwrap_or(DEFAULT_FONT), &st);
+    let replace = bool_p(p, "replace").unwrap_or(true);
+    let count = s.edit("Sottotitoli Jarvis", |pr, _st| {
+        let src = crate::graphics::graphic_source(pr, w, h, rate);
+        let mut items = Vec::new();
+        let mut last_end = Tick::ZERO;
+        for (a, b, text, hl, pp, gi) in &pieces {
+            let a = rate.snap(*a).max(last_end);
+            let b = rate.snap(*b);
+            if b <= a {
+                continue;
+            }
+            let Some(mut ti) = pr.make_track_item(src, TrackKind::Video, a, TimeRange::new(Tick::ZERO, b - a), rate) else { continue };
+            ti.name = text.clone();
+            let mut layer = caption_layer(&st, &font, text, hl.clone(), pos, size, &anim, *pp, b - a, if tilt_on { if gi % 2 == 0 { -3.0 } else { 3.0 } } else { 0.0 }, rate);
+            filmcraft_project::resolve_auto_points(&mut layer, (w, h), (w, h));
+            ti.effects.push(layer);
+            ensure_layer_uids(&mut ti.effects);
+            last_end = b;
+            items.push(ti);
+        }
+        let tid = TrackId(pr.alloc_id());
+        let q = pr.sequence_mut(seq_id).ok_or(EngineError::NoSequence)?;
+        let n = items.len();
+        if let Some(r) = &ranges
+            && let Some(t) = q.video_tracks.iter_mut().find(|t| t.name == CAPTION_TRACK)
+        {
+            // solo le clip scelte: via i sottotitoli vecchi in quei tratti, gli altri restano
+            t.items.retain(|it| !r.iter().any(|(a, b)| it.start < *b && it.end() > *a));
+            t.items.extend(items);
+            t.sort();
+        } else {
+            if replace {
+                q.video_tracks.retain(|t| t.name != CAPTION_TRACK);
+            }
+            let mut t = Track::new(tid, TrackKind::Video, CAPTION_TRACK.to_string());
+            t.items = items;
+            t.sort();
+            q.video_tracks.push(t);
+        }
+        q.check().map_err(EngineError::Other)?;
+        Ok(n)
+    })?;
+    let _ = TEXT_LAYER;
+    Ok(json!({"captions": count, "words": words.len(), "style": st.id, "font": font.0}))
+}
