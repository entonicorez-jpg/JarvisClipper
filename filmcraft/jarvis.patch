+// ---------------------------------------------------------------- effetti sulle clip
+
+pub const CLIP_FX: &[(&str, &str)] = &[
+    ("punch", "Punch-in (zoom secco)"),
+    ("zoom_in", "Zoom lento avanti"),
+    ("zoom_out", "Zoom lento indietro"),
+    ("shake", "Shake reazione"),
+];
+
+fn target_clips(s: &Session) -> Vec<ClipId> {
+    let Some(q) = s.active_sequence() else { return Vec::new() };
+    let vids: Vec<ClipId> = q.video_tracks.iter().flat_map(|t| t.items.iter()).map(|i| i.id).filter(|c| s.state.selection.contains(c)).collect();
+    if !vids.is_empty() {
+        return vids;
+    }
+    let t = s.playhead();
+    q.video_tracks.iter().rev().filter(|tr| tr.name != CAPTION_TRACK).find_map(|tr| tr.item_at(t).map(|i| i.id)).into_iter().collect()
+}
+
+fn clip_fx(s: &mut Session, p: &Value) -> Result<Value> {
+    let fx = str_p(p, "preset").unwrap_or("punch").to_string();
+    let amount = f64_p(p, "amount").unwrap_or(1.0).clamp(0.2, 3.0);
+    let clips = target_clips(s);
+    if clips.is_empty() {
+        return Err(bad("jarvis.clipFx", "nessuna clip: seleziona le clip o metti l'indicatore su una clip"));
+    }
+    let (w, h) = s.active_sequence().map(|q| (q.settings.width as f64, q.settings.height as f64)).unwrap_or((1920.0, 1080.0));
+    let rate = s.sequence_rate();
+    let f = rate.frame_duration();
+    let n = s.edit_sequence("Effetto Jarvis", |q, _ctx, _st| {
+        let mut n = 0;
+        for c in &clips {
+            let Some((_, it)) = q.find_item_mut(*c) else { continue };
+            let dur = it.duration;
+            let b0 = it.source_in;
+            let Some(m) = it.effect_mut("motion") else { continue };
+            let base = m.params.get("scale").map(|p| p.f64_at(b0)).unwrap_or(100.0);
+            let base_pos = m.params.get("position").map(|p| p.vec2_at(b0)).filter(|v| v.x.is_finite() && v.y.is_finite()).unwrap_or(Vec2::new(w / 2.0, h / 2.0));
+            match fx.as_str() {
+                "punch" => {
+                    let mut sp = Param::new(ParamValue::Float(base));
+                    sp.put_keyframe(b0, ParamValue::Float(base));
+                    sp.put_keyframe(Tick(b0.0 + f.0 * 3), ParamValue::Float(base * (1.0 + 0.18 * amount)));
+                    for k in &mut sp.keyframes {
+                        k.interp = Interpolation::EaseOut;
+                    }
+                    m.params.insert("scale".into(), sp);
+                }
+                "zoom_in" | "zoom_out" => {
+                    let (a, b) = if fx == "zoom_in" { (base, base * (1.0 + 0.1 * amount)) } else { (base * (1.0 + 0.1 * amount), base) };
+                    let mut sp = Param::new(ParamValue::Float(a));
+                    sp.put_keyframe(b0, ParamValue::Float(a));
+                    sp.put_keyframe(Tick(b0.0 + dur.0), ParamValue::Float(b));
+                    m.params.insert("scale".into(), sp);
+                }
+                "shake" => {
+                    let amp = w.min(h) * 0.018 * amount;
+                    let offs = [(1.0, -0.6), (-0.9, 0.8), (0.7, 0.5), (-0.5, -0.7), (0.35, 0.3), (-0.2, -0.15), (0.0, 0.0)];
+                    let mut pp = Param::new(ParamValue::Vec2(base_pos));
+                    for (k, (dx, dy)) in offs.iter().enumerate() {
+                        let t = Tick(f.0 * 2 * k as i64);
+                        if t > dur {
+                            break;
+                        }
+                        let decay = 1.0 - k as f64 / offs.len() as f64;
+                        pp.put_keyframe(Tick(b0.0 + t.0), ParamValue::Vec2(Vec2::new(base_pos.x + dx * amp * decay, base_pos.y + dy * amp * decay)));
+                    }
+                    m.params.insert("position".into(), pp);
+                    // un filo di zoom per non mostrare i bordi
+                    if m.params.get("scale").map_or(true, |p| !p.is_animated()) {
+                        m.params.insert("scale".into(), Param::new(ParamValue::Float(base * (1.0 + 0.05 * amount))));
+                    }
+                }
+                _ => return Err(bad("jarvis.clipFx", "preset sconosciuto")),
+            }
+            n += 1;
+        }
+        Ok(n)
+    })?;
+    let mut sfx = 0;
+    let kind = match fx.as_str() {
+        "punch" => sfx_kind("punch"),
+        "shake" => sfx_kind("shake_fx"),
+        _ => None,
+    };
+    if let (true, Some(kind)) = (bool_p(p, "sfx").unwrap_or(true), kind) {
+        let q = s.active_sequence();
+        let sounds: Vec<_> = clips
+            .iter()
+            .enumerate()
+            .filter_map(|(k, c)| Some((pick_sfx(kind, k)?, q?.find_item(*c)?.1.start)))
+            .collect();
+        sfx = place_sfx(s, sounds, f64_p(p, "sfxGain").unwrap_or(-3.0))?;
+    }
+    Ok(json!({"clips": n, "sfx": sfx}))
+}
