+// ---------------------------------------------------------------- effetti sonori (SFX)
+// I suoni vengono dalle cartelle che l'utente ha sul suo PC (Premiere Composer / Mister Horse,
+// "Premiere Composer Files" sul Desktop) o da %LOCALAPPDATA%\FilmCraftJarvis\sfx: non sono nella build.
+
+pub const SFX_TRACK: &str = "SFX Jarvis";
+
+fn sfx_roots() -> Vec<std::path::PathBuf> {
+    let mut v = Vec::new();
+    if let Some(la) = std::env::var_os("LOCALAPPDATA").map(std::path::PathBuf::from) {
+        v.push(la.join("FilmCraftJarvis").join("sfx"));
+        v.push(la.join("MisterHorse").join("ProductManager").join("Products"));
+    }
+    if let Some(home) = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME")).map(std::path::PathBuf::from) {
+        v.push(home.join("Desktop").join("Premiere Composer Files"));
+        v.push(home.join("Documents").join("Premiere Composer Files"));
+    }
+    if let Some(extra) = std::env::var_os("JARVIS_SFX_DIR") {
+        v.push(std::path::PathBuf::from(extra));
+    }
+    v
+}
+
+fn walk_sfx(dir: &std::path::Path, depth: usize, out: &mut Vec<std::path::PathBuf>) {
+    if depth > 6 || out.len() > 400 {
+        return;
+    }
+    let Ok(rd) = std::fs::read_dir(dir) else { return };
+    for e in rd.flatten() {
+        let p = e.path();
+        if p.is_dir() {
+            walk_sfx(&p, depth + 1, out);
+        } else if p.extension().and_then(|x| x.to_str()).is_some_and(|x| matches!(x.to_ascii_lowercase().as_str(), "wav" | "mp3" | "aif" | "aiff" | "flac" | "ogg")) {
+            out.push(p);
+        }
+    }
+}
+
+/// Tutti i suoni trovati (una volta per sessione).
+pub fn sfx_library() -> &'static Vec<std::path::PathBuf> {
+    static LIB: std::sync::OnceLock<Vec<std::path::PathBuf>> = std::sync::OnceLock::new();
+    LIB.get_or_init(|| {
+        let mut v = Vec::new();
+        for r in sfx_roots() {
+            walk_sfx(&r, 0, &mut v);
+        }
+        let mut seen = std::collections::HashSet::new();
+        v.retain(|p| seen.insert(p.file_name().map(|n| n.to_string_lossy().to_lowercase()).unwrap_or_default()));
+        v.sort();
+        v
+    })
+}
+
+/// Il suono per un tipo di effetto (`k` fa girare tra quelli disponibili).
+pub fn pick_sfx(kind: &str, k: usize) -> Option<std::path::PathBuf> {
+    let keys: &[&str] = match kind {
+        "swoosh" => &["swoosh 0", "swoosh"],
+        "transition" => &["swoosh transition", "transition basic", "swoosh"],
+        "complex" => &["transition complex", "swoosh transition"],
+        "glitch" => &["glitch", "hiss"],
+        "boom" => &["boom"],
+        "pop" => &["pop"],
+        _ => &["swoosh"],
+    };
+    let lib = sfx_library();
+    for key in keys {
+        let hits: Vec<&std::path::PathBuf> = lib.iter().filter(|p| p.file_name().map(|n| n.to_string_lossy().to_lowercase()).unwrap_or_default().contains(key)).collect();
+        if !hits.is_empty() {
+            return Some(hits[k % hits.len()].clone());
+        }
+    }
+    None
+}
+
+/// Il tipo di suono di ogni effetto Jarvis.
+pub fn sfx_kind(preset: &str) -> Option<&'static str> {
+    Some(match preset {
+        "c_zoom_in" | "zoom_blur" | "cross_zoom" | "dissolve" => "transition",
+        "c_slide_left" | "c_slide_right" | "c_slide_up" | "c_slide_down" | "c_whip" | "whip" | "push" => "swoosh",
+        "c_zoom_spin" | "spin" | "light_leak" => "complex",
+        "c_glitch" | "glitch" | "vhs" => "glitch",
+        "c_impact" | "shake" | "flash" => "boom",
+        "punch" => "pop",
+        "shake_fx" => "boom",
+        _ => return None,
+    })
+}
+
+fn media_with_path(s: &Session, path: &str) -> Option<filmcraft_project::ItemId> {
+    s.project.items.iter().find_map(|(id, it)| match it.as_media().map(|m| &m.media) {
+        Some(filmcraft_project::MediaRef::File { path: p }) if p == path => Some(*id),
+        _ => None,
+    })
+}
+
+/// Mette i suoni `(file, inizio in timeline)` sulla traccia "SFX Jarvis" (una sola modifica annullabile).
+pub fn place_sfx(s: &mut Session, sounds: Vec<(std::path::PathBuf, Tick)>, gain_db: f64) -> Result<usize> {
+    if sounds.is_empty() {
+        return Ok(0);
+    }
+    let seq_id = s.state.active_sequence.ok_or(EngineError::NoSequence)?;
+    let rate = s.sequence_rate();
+    let mut placed: Vec<(filmcraft_project::ItemId, Tick)> = Vec::new();
+    for (p, t) in sounds {
+        let ps = p.to_string_lossy().to_string();
+        let item = match media_with_path(s, &ps) {
+            Some(i) => i,
+            None => {
+                let r = s.execute("file.import", json!({"paths": [ps.clone()]}))?;
+                match r["items"].as_array().and_then(|a| a.first()).and_then(Value::as_u64) {
+                    Some(i) => filmcraft_project::ItemId(i),
+                    None => continue,
+                }
+            }
+        };
+        placed.push((item, t));
+    }
+    s.edit("Suoni Jarvis", |pr, _st| {
+        let mut items = Vec::new();
+        for (item, t) in &placed {
+            let dur = match pr.item(*item).map(|i| &i.kind) {
+                Some(filmcraft_project::ItemKind::Media(m)) => m.duration(),
+                _ => continue,
+            };
+            let t = rate.snap((*t).max(Tick::ZERO));
+            let Some(mut ti) = pr.make_track_item(*item, TrackKind::Audio, t, TimeRange::new(Tick::ZERO, dur), rate) else { continue };
+            if gain_db != 0.0 {
+                ti.gain_db = gain_db;
+            }
+            items.push(ti);
+        }
+        let mut ids: Vec<TrackId> = Vec::new();
+        for _ in 0..4 {
+            ids.push(TrackId(pr.alloc_id()));
+        }
+        let q = pr.sequence_mut(seq_id).ok_or(EngineError::NoSequence)?;
+        let n = items.len();
+        for ti in items {
+            let range = ti.range();
+            let free = |tr: &Track| !tr.items.iter().any(|i| i.range().overlaps(&range));
+            let idx = q.audio_tracks.iter().position(|tr| tr.name.starts_with(SFX_TRACK) && free(tr));
+            let idx = match idx {
+                Some(i) => i,
+                None => {
+                    let k = q.audio_tracks.iter().filter(|tr| tr.name.starts_with(SFX_TRACK)).count();
+                    let id = ids.pop().unwrap_or(TrackId(0));
+                    let name = if k == 0 { SFX_TRACK.to_string() } else { format!("{SFX_TRACK} {}", k + 1) };
+                    q.audio_tracks.push(Track::new(id, TrackKind::Audio, name));
+                    q.audio_tracks.len() - 1
+                }
+            };
+            q.audio_tracks[idx].items.push(ti);
+            q.audio_tracks[idx].sort();
+        }
+        q.check().map_err(EngineError::Other)?;
+        Ok(n)
+    })
+}
