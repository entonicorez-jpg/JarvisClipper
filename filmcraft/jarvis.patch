+
+/// Jarvis: i file della cartella e delle sottocartelle (fino a 4 livelli) che contengono `q` nel nome.
+fn search_entries(app: &FilmcraftApp, ctx: &egui::Context, dir: &str, filter: &str, q: &str) -> Vec<Entry> {
+    let q = q.to_lowercase();
+    let words: Vec<&str> = q.split_whitespace().collect();
+    let hit = |n: &str| {
+        let n = n.to_lowercase();
+        words.iter().all(|w| n.contains(w))
+    };
+    let mut out = Vec::new();
+    let mut stack = vec![(dir.to_string(), 0usize)];
+    let mut seen = 0usize;
+    while let Some((d, depth)) = stack.pop() {
+        seen += 1;
+        if seen > 400 || out.len() >= 500 {
+            break;
+        }
+        let Ok(list) = listing(app, ctx, &d, filter) else { continue };
+        for e in list.iter() {
+            if hit(&e.name) {
+                out.push(e.clone());
+            }
+            if e.is_dir && depth < 4 {
+                stack.push((e.path.clone(), depth + 1));
+            }
+        }
+    }
+    out.sort_by(|a, b| b.is_dir.cmp(&a.is_dir).then(a.name.to_lowercase().cmp(&b.name.to_lowercase())));
+    out
 }
 
