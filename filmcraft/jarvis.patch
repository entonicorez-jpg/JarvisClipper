+// ---------------------------------------------------------------- Jarvis: Trasforma / Ritaglia
+// I due pulsanti in basso a sinistra del Program (come Premiere): "Trasforma" mostra sempre il
+// riquadro con le maniglie sulla clip selezionata (o su quella più in alto sotto l'indicatore);
+// "Ritaglia" mostra i bordi del ritaglio, che si trascinano (effetto Crop, aggiunto se manca).
+
+/// La clip su cui lavorano i pulsanti: una selezionata sotto l'indicatore, se no la più in alto.
+fn jarvis_clip(app: &FilmcraftApp) -> Option<&TrackItem> {
+    let seq = app.session.active_sequence()?;
+    let t = app.session.playhead();
+    let under: Vec<&TrackItem> = seq.video_tracks.iter().rev().filter(|tr| tr.enabled).filter_map(|tr| tr.item_at(t)).filter(|it| it.enabled).collect();
+    under.iter().find(|it| app.session.state.selection.contains(&it.id)).or(under.first()).copied()
+}
+
+#[derive(Clone, Copy, Debug)]
+struct CropDrag {
+    clip: ClipId,
+    /// quali bordi muove: sinistra, sopra, destra, sotto
+    edges: [bool; 4],
+    start: Pos2,
+    from: [f64; 4],
+}
+
+pub fn jarvis_overlay(app: &mut FilmcraftApp, ui: &mut egui::Ui, pic: Rect, frame: (u32, u32)) {
+    let mode = app.jarvis_ui.xform;
+    if mode == 0 || app.ui.tool != Tool::Selection {
+        return;
+    }
+    let Some(it) = jarvis_clip(app) else { return };
+    let clip = it.id;
+    let mut actions: Vec<(String, Value)> = Vec::new();
+    if mode == 1 {
+        // Trasforma: Motion selezionato sulla clip, così compaiono le maniglie
+        let ok = selected_effect(app).is_some_and(|s| s.0.0 == clip && (s.3.id == "motion" || s.3.id == "transform"));
+        if !ok {
+            if !app.session.state.selection.contains(&clip) {
+                actions.push(("timeline.select".into(), json!({"clips": [clip.0]})));
+            }
+            actions.push(("effects.select".into(), json!({"clip": clip.0, "effect": "motion"})));
+        }
+        crate::panels::effect_controls::run(app, ui.ctx(), actions);
+        return;
+    }
+    // Ritaglia
+    let reach = ui.clip_rect().shrink(REACH_INSET);
+    let Some(motion) = it.effects.iter().find(|e| e.effect == "motion") else { return };
+    let mt = it.effect_time_at(app.session.playhead());
+    let Some(pl) = placement(app, it, motion, mt, pic, reach, frame) else { return };
+    let crop_idx = it.effects.iter().position(|e| e.effect == "crop");
+    let cur: [f64; 4] = crop_idx.map_or([0.0; 4], |i| {
+        let e = &it.effects[i];
+        ["left", "top", "right", "bottom"].map(|k| e.f64_at(k, mt))
+    });
+    let [tl, tr, br, bl] = pl.quad;
+    let at = |u: f32, v: f32| -> Pos2 {
+        let top = tl + (tr - tl) * u;
+        let bot = bl + (br - bl) * u;
+        top + (bot - top) * v
+    };
+    let (l, t, r, b) = ((cur[0] / 100.0) as f32, (cur[1] / 100.0) as f32, (cur[2] / 100.0) as f32, (cur[3] / 100.0) as f32);
+    let (u0, u1, v0, v1) = (l, 1.0 - r, t, 1.0 - b);
+    let corners = [at(u0, v0), at(u1, v0), at(u1, v1), at(u0, v1)];
+    let p = ui.painter().with_clip_rect(ui.clip_rect());
+    // fuori dal ritaglio: velo scuro sull'intera clip, dentro il bordo bianco con gli angoli a L
+    p.add(egui::Shape::convex_polygon(pl.quad.to_vec(), Color32::from_black_alpha(0), Stroke::new(1.0, Color32::from_white_alpha(70))));
+    let white = Stroke::new(1.5, Color32::WHITE);
+    p.add(egui::Shape::closed_line(corners.to_vec(), white));
+    let thick = Stroke::new(4.0, Color32::WHITE);
+    for i in 0..4 {
+        let c = corners[i];
+        let a = corners[(i + 1) % 4];
+        let z = corners[(i + 3) % 4];
+        let la = ((a - c).length()).max(1.0);
+        let lz = ((z - c).length()).max(1.0);
+        p.line_segment([c, c + (a - c) * (14.0 / la).min(0.4)], thick);
+        p.line_segment([c, c + (z - c) * (14.0 / lz).min(0.4)], thick);
+        // maniglia a metà lato
+        let m = c + (a - c) * 0.5;
+        let dir = (a - c) / la;
+        p.line_segment([m - dir * 9.0, m + dir * 9.0], thick);
+    }
+    // cosa si prende: angoli (due bordi) e lati (uno)
+    let id = egui::Id::unique("jarvis-crop");
+    let area = Rect::from_points(&corners).expand(16.0);
+    let resp = ui.interact(area, id, Sense::click_and_drag());
+    let grab = |pt: Pos2| -> Option<[bool; 4]> {
+        let near = |a: Pos2, b: Pos2| {
+            let ab = b - a;
+            let tt = ((pt - a).dot(ab) / ab.length_sq().max(1e-3)).clamp(0.0, 1.0);
+            (a + ab * tt - pt).length() < 10.0
+        };
+        for (i, c) in corners.iter().enumerate() {
+            if (*c - pt).length() < 14.0 {
+                // 0 TL: sinistra+sopra, 1 TR: destra+sopra, 2 BR: destra+sotto, 3 BL: sinistra+sotto
+                return Some([[true, true, false, false], [false, true, true, false], [false, false, true, true], [true, false, false, true]][i]);
+            }
+        }
+        if near(corners[0], corners[1]) {
+            return Some([false, true, false, false]);
+        }
+        if near(corners[1], corners[2]) {
+            return Some([false, false, true, false]);
+        }
+        if near(corners[2], corners[3]) {
+            return Some([false, false, false, true]);
+        }
+        if near(corners[3], corners[0]) {
+            return Some([true, false, false, false]);
+        }
+        None
+    };
+    let drag_id = id.with("drag");
+    if resp.drag_started() {
+        let pt = ui.input(|i| i.pointer.press_origin()).or(resp.interact_pointer_pos()).unwrap_or(corners[0]);
+        if let Some(edges) = grab(pt) {
+            ui.data_mut(|d| d.insert_temp(drag_id, CropDrag { clip, edges, start: pt, from: cur }));
+            if crop_idx.is_none() {
+                actions.push(("effects.apply".into(), json!({"clips": [clip.0], "effect": "crop"})));
+            }
+        }
+    }
+    if let Some(pt) = resp.hover_pos()
+        && let Some(e) = grab(pt)
+    {
+        let icon = match e {
+            [true, true, false, false] | [false, false, true, true] => CursorIcon::ResizeNwSe,
+            [false, true, true, false] | [true, false, false, true] => CursorIcon::ResizeNeSw,
+            [true, false, false, false] | [false, false, true, false] => CursorIcon::ResizeHorizontal,
+            _ => CursorIcon::ResizeVertical,
+        };
+        ui.ctx().set_cursor_icon(icon);
+    }
+    let drag: Option<CropDrag> = ui.data(|d| d.get_temp(drag_id)).filter(|d: &CropDrag| d.clip == clip);
+    if let Some(d) = drag
+        && resp.dragged()
+        && let Some(pt) = resp.interact_pointer_pos()
+    {
+        // lo spostamento in frazioni della clip, lungo i suoi lati (vale anche ruotata)
+        let ux = tr - tl;
+        let vy = bl - tl;
+        let mv = pt - d.start;
+        let du = (mv.dot(ux) / ux.length_sq().max(1e-3)) as f64 * 100.0;
+        let dv = (mv.dot(vy) / vy.length_sq().max(1e-3)) as f64 * 100.0;
+        let mut v = d.from;
+        if d.edges[0] {
+            v[0] = (d.from[0] + du).clamp(0.0, 99.0 - v[2]);
+        }
+        if d.edges[2] {
+            v[2] = (d.from[2] - du).clamp(0.0, 99.0 - v[0]);
+        }
+        if d.edges[1] {
+            v[1] = (d.from[1] + dv).clamp(0.0, 99.0 - v[3]);
+        }
+        if d.edges[3] {
+            v[3] = (d.from[3] - dv).clamp(0.0, 99.0 - v[1]);
+        }
+        if let Some(idx) = it.effects.iter().position(|e| e.effect == "crop") {
+            for (k, name) in ["left", "top", "right", "bottom"].iter().enumerate() {
+                if d.edges[k] {
+                    actions.push(("effects.setParam".into(), json!({"clip": clip.0, "effect": idx, "param": name, "value": (v[k] * 100.0).round() / 100.0, "merge": MERGE})));
+                }
+            }
+        }
+    }
+    if resp.drag_stopped() {
+        ui.data_mut(|d| d.remove::<CropDrag>(drag_id));
+    }
+    crate::panels::effect_controls::run(app, ui.ctx(), actions);
+}
+
+/// I due pulsanti in basso a sinistra del Program: Trasforma e Ritaglia.
+pub fn jarvis_buttons(app: &mut FilmcraftApp, ui: &mut egui::Ui, row: Rect) {
+    let t = app.tokens;
+    for (k, (mode, tip)) in [(1u8, "Trasforma: maniglie per spostare, ingrandire e ruotare la clip"), (2u8, "Ritaglia: trascina i bordi per tagliare la clip")].iter().enumerate() {
+        let r = Rect::from_min_size(pos2(row.min.x + 6.0 + k as f32 * 30.0, row.min.y + 3.0), vec2(26.0, 24.0));
+        let resp = ui.interact(r, egui::Id::unique(("jarvis-xform", k)), Sense::click()).on_hover_text(*tip);
+        app.auto.add(&format!("program.jarvis.xform.{k}"), r, tip);
+        let on = app.jarvis_ui.xform == *mode;
+        if on {
+            ui.painter().rect_filled(r, 4.0, t.accent);
+        } else if resp.hovered() {
+            ui.painter().rect_filled(r, 4.0, t.hover);
+        }
+        let c = if on { Color32::WHITE } else { t.icon };
+        let q = r.shrink(6.0);
+        let st = Stroke::new(1.5, c);
+        if *mode == 1 {
+            // riquadro con le maniglie agli angoli
+            ui.painter().rect_stroke(q, 0.0, Stroke::new(1.0, c), StrokeKind::Middle);
+            for p in [q.left_top(), q.right_top(), q.right_bottom(), q.left_bottom()] {
+                ui.painter().rect_filled(Rect::from_center_size(p, vec2(4.0, 4.0)), 0.0, c);
+            }
+        } else {
+            // icona del ritaglio: due L incrociate
+            ui.painter().line_segment([pos2(q.min.x + 3.0, q.min.y - 1.0), pos2(q.min.x + 3.0, q.max.y - 3.0)], st);
+            ui.painter().line_segment([pos2(q.min.x + 3.0, q.max.y - 3.0), pos2(q.max.x + 1.0, q.max.y - 3.0)], st);
+            ui.painter().line_segment([pos2(q.min.x - 1.0, q.min.y + 3.0), pos2(q.max.x - 3.0, q.min.y + 3.0)], st);
+            ui.painter().line_segment([pos2(q.max.x - 3.0, q.min.y + 3.0), pos2(q.max.x - 3.0, q.max.y + 1.0)], st);
+        }
+        if resp.clicked() {
+            app.jarvis_ui.xform = if on { 0 } else { *mode };
+            if app.jarvis_ui.xform != 1 {
+                let ctx = ui.ctx().clone();
+                crate::panels::effect_controls::run(app, &ctx, vec![("effects.select".into(), json!({"none": true}))]);
+            }
+        }
+    }
+}
