+// ---------------------------------------------------------------- preset di Premiere importati da soli
+// I file .prfpset messi in %LOCALAPPDATA%\FilmCraftJarvis\presets vengono importati all'avvio
+// (una volta per file/versione). Gli zoom degli short rifatti dall'utente non vengono reimportati.
+
+const SKIP_PRESETS: &[&str] = &["zoom shorts", "dezoom shorts"];
+
+/// Importa un file di preset Premiere (salta gli zoom degli short già rifatti). Ritorna quanti.
+fn import_prfpset(app: &mut FilmcraftApp, ctx: &egui::Context, path: &str) -> Result<usize, String> {
+    let names = |app: &mut FilmcraftApp| -> Vec<String> {
+        crate::menus::invoke(app, ctx, "presets.list", json!({}))
+            .ok()
+            .and_then(|v| v["presets"].as_array().map(|a| a.iter().filter_map(|x| x["name"].as_str().map(str::to_string)).collect()))
+            .unwrap_or_default()
+    };
+    let before = names(app);
+    let r = crate::menus::invoke(app, ctx, "presets.import", json!({"path": path}))?;
+    let imported: Vec<String> = r["imported"].as_array().map(|a| a.iter().filter_map(|x| x.as_str().map(str::to_string)).collect()).unwrap_or_default();
+    let mut count = 0;
+    for n in &imported {
+        if SKIP_PRESETS.iter().any(|s| n.eq_ignore_ascii_case(s)) && !before.iter().any(|b| b == n) {
+            let _ = crate::menus::invoke(app, ctx, "presets.delete", json!({"name": n}));
+        } else {
+            count += 1;
+        }
+    }
+    Ok(count)
+}
+
+pub(crate) fn pick_and_import(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let files = app.hooks.pick_files.as_mut().map(|f| f(&["prfpset"])).unwrap_or_default();
+    let mut total = 0;
+    for f in files {
+        match import_prfpset(app, ctx, &f) {
+            Ok(n) => total += n,
+            Err(e) => {
+                app.jarvis_ui.msg = format!("⚠ {e}");
+                return;
+            }
+        }
+    }
+    if total > 0 {
+        app.jarvis_ui.msg = format!("✅ Importati {total} preset: li trovi in Effetti › Preset (trascinali sulle clip)");
+    }
+}
+
+pub(crate) fn auto_presets(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let Some(dir) = std::env::var_os("LOCALAPPDATA").map(|d| std::path::PathBuf::from(d).join("FilmCraftJarvis").join("presets")) else { return };
+    let Ok(rd) = std::fs::read_dir(&dir) else { return };
+    let marker = dir.join("importati.txt");
+    let done = std::fs::read_to_string(&marker).unwrap_or_default();
+    let mut new_lines = Vec::new();
+    let mut count = 0usize;
+    for e in rd.flatten() {
+        let p = e.path();
+        if !p.extension().and_then(|x| x.to_str()).is_some_and(|x| x.eq_ignore_ascii_case("prfpset")) {
+            continue;
+        }
+        let stamp = e.metadata().ok().and_then(|m| m.modified().ok()).and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok()).map(|d| d.as_secs()).unwrap_or(0);
+        let key = format!("{}|{}", p.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default(), stamp);
+        if done.lines().any(|l| l == key) {
+            continue;
+        }
+        let names = |app: &mut FilmcraftApp| -> Vec<String> {
+            crate::menus::invoke(app, ctx, "presets.list", json!({}))
+                .ok()
+                .and_then(|v| v["presets"].as_array().map(|a| a.iter().filter_map(|x| x["name"].as_str().map(str::to_string)).collect()))
+                .unwrap_or_default()
+        };
+        let before = names(app);
+        match crate::menus::invoke(app, ctx, "presets.import", json!({"path": p.to_string_lossy()})) {
+            Ok(r) => {
+                let imported: Vec<String> = r["imported"].as_array().map(|a| a.iter().filter_map(|x| x.as_str().map(str::to_string)).collect()).unwrap_or_default();
+                for n in &imported {
+                    if SKIP_PRESETS.iter().any(|s| n.eq_ignore_ascii_case(s)) && !before.iter().any(|b| b == n) {
+                        let _ = crate::menus::invoke(app, ctx, "presets.delete", json!({"name": n}));
+                    } else {
+                        count += 1;
+                    }
+                }
+                new_lines.push(key);
+            }
+            Err(e) => app.jarvis_ui.msg = format!("⚠ Preset {}: {e}", p.display()),
+        }
+    }
+    if !new_lines.is_empty() {
+        let mut all = done;
+        for l in new_lines {
+            all.push_str(&l);
+            all.push('\n');
+        }
+        let _ = std::fs::write(&marker, all);
+        app.ui.status = format!("Importati {count} preset di Premiere (pannello Effetti › Preset)");
+    }
+}
