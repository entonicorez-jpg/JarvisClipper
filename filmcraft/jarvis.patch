+
+/// Lavoro di trascrizione preparato sul thread dell'interfaccia e fatto in background.
+pub struct CaptionJob {
+    /// Trascrizioni già pronte (fatte da Jarvis Clipper con la scheda video): niente Whisper.
+    pub pre: Vec<(filmcraft_project::ItemId, filmcraft_project::Transcript)>,
+    pub items: Vec<(filmcraft_project::ItemId, filmcraft_media::SharedSource, Vec<(Tick, Tick)>)>,
+    /// Il file di ogni elemento (per farlo trascrivere a Jarvis Clipper).
+    pub paths: std::collections::HashMap<u64, String>,
+    /// Le trascrizioni che c'erano già, da tenere fuori dai tratti rifatti.
+    pub existing: std::collections::HashMap<u64, (std::sync::Arc<filmcraft_project::Transcript>, Vec<(Tick, Tick)>)>,
+    pub model: String,
+    pub language: Option<String>,
+    pub installed: Option<std::sync::Arc<dyn filmcraft_speech::Transcriber>>,
+}
+
+/// I pezzi di media (tempo del file) che suonano in `seq`, entrando nelle sequenze annidate.
+/// `window` = la parte della sequenza che si sente (None = tutta). Salta SFX e audio cortissimi
+/// (bip della censura, swoosh): Whisper su un bip si inventa "Sottotitoli a cura di…".
+fn collect_audio(pr: &filmcraft_project::Project, seq: &filmcraft_project::Sequence, window: Option<(Tick, Tick)>, per: &mut std::collections::BTreeMap<u64, Vec<(Tick, Tick)>>, depth: usize) {
+    if depth > 8 {
+        return;
+    }
+    let pad = Tick::from_seconds_f64(0.5);
+    for tr in &seq.audio_tracks {
+        if tr.name.starts_with(SFX_TRACK) || tr.muted {
+            continue;
+        }
+        for it in tr.items.iter().filter(|i| i.enabled && i.speed > 0.0) {
+            let (mut a, mut b) = (it.start, it.end());
+            if let Some((wa, wb)) = window {
+                a = a.max(wa);
+                b = b.min(wb);
+            }
+            if b <= a {
+                continue;
+            }
+            let m = |t: Tick| it.source_in + Tick(((t - it.start).0 as f64 * it.speed).round() as i64);
+            let (ma, mb) = (m(a), m(b));
+            match pr.item(it.item).map(|x| &x.kind) {
+                Some(filmcraft_project::ItemKind::Sequence(inner)) => collect_audio(pr, inner, Some((ma, mb)), per, depth + 1),
+                _ => {
+                    let Some((root, media, _)) = pr.resolve_media(it.item) else { continue };
+                    let nm = pr.item(root).map(|x| x.name.to_lowercase()).unwrap_or_default();
+                    if media.duration() < Tick::from_seconds_f64(6.0) || ["censura", "swoosh", "whoosh", "sfx", "bip"].iter().any(|k| nm.contains(k)) {
+                        continue;
+                    }
+                    per.entry(root.0).or_default().push((Tick((ma.0 - pad.0).max(0)), mb + pad));
+                }
+            }
+        }
+    }
+}
+
+/// Le sequenze annidate usate come audio (prima le più interne).
+fn find_nests(pr: &filmcraft_project::Project, seq: &filmcraft_project::Sequence, out: &mut Vec<(filmcraft_project::ItemId, std::sync::Arc<filmcraft_project::Sequence>)>, depth: usize) {
+    if depth > 8 {
+        return;
+    }
+    for tr in &seq.audio_tracks {
+        for it in &tr.items {
+            if let Some(filmcraft_project::ItemKind::Sequence(inner)) = pr.item(it.item).map(|x| &x.kind) {
+                if out.iter().any(|(i, _)| *i == it.item) {
+                    continue;
+                }
+                find_nests(pr, inner, out, depth + 1);
+                out.push((it.item, inner.clone()));
+            }
+        }
+    }
+}
+
+/// La trascrizione che Jarvis Clipper salva accanto al video (`<video>.jarvis-words.json`:
+/// `{"words":[{"w","s","e"}]}`, secondi del file). Si usa solo se copre i pezzi che servono.
+fn jarvis_sidecar(s: &Session, item: filmcraft_project::ItemId, ranges: &[(Tick, Tick)]) -> Option<filmcraft_project::Transcript> {
+    let filmcraft_project::ItemKind::Media(m) = &s.project.item(item)?.kind else { return None };
+    let filmcraft_project::MediaRef::File { path } = &m.media else { return None };
+    let txt = std::fs::read_to_string(format!("{path}.jarvis-words.json")).ok()?;
+    let v: Value = serde_json::from_str(&txt).ok()?;
+    let covered: Vec<(f64, f64)> = v["ranges"].as_array()?.iter().filter_map(|r| Some((r[0].as_f64()?, r[1].as_f64()?))).collect();
+    // ogni pezzo usato deve stare (quasi) tutto dentro le parti già trascritte
+    for (a, b) in ranges {
+        let (a, b) = (a.seconds() + 0.6, b.seconds() - 0.6);
+        if b > a && !covered.iter().any(|(ca, cb)| *ca <= a + 0.5 && *cb >= b - 0.5) {
+            return None;
+        }
+    }
+    let mut words: Vec<filmcraft_project::Word> = v["words"]
+        .as_array()?
+        .iter()
+        .filter_map(|w| {
+            let t = w["w"].as_str()?.trim();
+            let (a, b) = (w["s"].as_f64()?, w["e"].as_f64()?);
+            (!t.is_empty() && b >= a).then(|| filmcraft_project::Word::new(t, Tick::from_seconds_f64(a), Tick::from_seconds_f64(b.max(a + 0.02))))
+        })
+        .collect();
+    drop_hallucinations(&mut words);
+    if words.is_empty() {
+        return None;
+    }
+    let mut tr = filmcraft_project::Transcript { language: "it".into(), source: "jarvis-clipper".into(), speakers: Vec::new(), words };
+    tr.normalize();
+    Some(tr)
+}
+
+/// Jarvis Clipper installato sul PC.
+pub fn jarvis_exe() -> Option<std::path::PathBuf> {
+    let la = std::env::var_os("LOCALAPPDATA").map(std::path::PathBuf::from)?;
+    let p = la.join("Programs").join("Jarvis Clipper").join("JarvisClipper.exe");
+    p.is_file().then_some(p)
+}
+
+/// Fa trascrivere a Jarvis Clipper (`--transcribe job out`) i pezzi `ranges` del file.
+fn jarvis_transcribe(exe: &std::path::Path, path: &str, ranges: &[(Tick, Tick)], lang: &str, progress: &dyn Fn(f32, String)) -> Option<filmcraft_project::Transcript> {
+    let dir = std::env::temp_dir().join(format!("filmcraft-jarvis-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).ok()?;
+    let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis()).unwrap_or(0);
+    let job = dir.join(format!("job-{stamp}.json"));
+    let out = dir.join(format!("out-{stamp}.json"));
+    let rs: Vec<[f64; 2]> = ranges.iter().map(|(a, b)| [a.seconds(), b.seconds()]).collect();
+    std::fs::write(&job, json!({"path": path, "ranges": rs, "lang": lang}).to_string()).ok()?;
+    let mut cmd = std::process::Command::new(exe);
+    cmd.arg("--transcribe").arg(&job).arg(&out);
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(0x0800_0000);
+    }
+    let mut child = cmd.spawn().ok()?;
+    let prog = std::path::PathBuf::from(format!("{}.progress", out.display()));
+    let started = std::time::Instant::now();
+    let status = loop {
+        if let Ok(Some(st)) = child.try_wait() {
+            break st;
+        }
+        if let Ok(t) = std::fs::read_to_string(&prog) {
+            let (f, m) = t.split_once(' ').unwrap_or((t.as_str(), ""));
+            progress(f.trim().parse::<f32>().unwrap_or(0.0).clamp(0.0, 1.0) * 0.98, format!("Jarvis: {m}"));
+        }
+        // al massimo un'ora (la prima volta scarica il modello)
+        if started.elapsed() > std::time::Duration::from_secs(3600) {
+            let _ = child.kill();
+            return None;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(300));
+    };
+    if !status.success() {
+        return None;
+    }
+    let v: Value = serde_json::from_str(&std::fs::read_to_string(&out).ok()?).ok()?;
+    let _ = std::fs::remove_file(&job);
+    let _ = std::fs::remove_file(&out);
+    let _ = std::fs::remove_file(&prog);
+    let mut words: Vec<filmcraft_project::Word> = v["words"]
+        .as_array()?
+        .iter()
+        .filter_map(|w| {
+            let t = w["w"].as_str()?.trim();
+            let (a, b) = (w["s"].as_f64()?, w["e"].as_f64()?);
+            (!t.is_empty() && b >= a).then(|| filmcraft_project::Word::new(t, Tick::from_seconds_f64(a), Tick::from_seconds_f64(b.max(a + 0.02))))
+        })
+        .collect();
+    drop_hallucinations(&mut words);
+    let mut tr = filmcraft_project::Transcript { language: lang.to_string(), source: "jarvis-clipper".into(), speakers: Vec::new(), words };
+    tr.normalize();
+    Some(tr)
+}
+
+/// Frasi che Whisper si inventa sul silenzio o sui suoni.
+fn hallucination(text: &str) -> bool {
+    let t = text.to_lowercase();
+    ["sottotitoli a cura", "sottotitoli creati", "amara.org", "qtss", "sottotitoli e revisione", "grazie per la visione", "iscriviti al canale"].iter().any(|k| t.contains(k))
+}
+
+/// Pezzi di testo uniti, per togliere le frasi inventate parola per parola.
+fn drop_hallucinations(words: &mut Vec<filmcraft_project::Word>) {
+    let n = words.len();
+    let mut kill = vec![false; n];
+    for i in 0..n {
+        let mut acc = String::new();
+        for j in i..(i + 8).min(n) {
+            acc.push(' ');
+            acc.push_str(&words[j].text);
+            if hallucination(&acc) {
+                for k in i..=j {
+                    kill[k] = true;
+                }
+                break;
+            }
+        }
+    }
+    let mut i = 0;
+    words.retain(|_| {
+        i += 1;
+        !kill[i - 1]
+    });
+}
+
+/// Prepara la trascrizione: solo i pezzi di audio usati nella sequenza. None = c'è già.
+pub fn prepare_captions(s: &Session, p: &Value) -> Result<Option<CaptionJob>> {
+    let ranges = caption_ranges(p);
+    let have = crate::transcript::sequence_words(s);
+    let have_here = match &ranges {
+        // nelle clip scelte c'è già il parlato trascritto (almeno metà dei tratti)
+        Some(r) => r.iter().filter(|(a, b)| have.iter().any(|w| w.start >= *a && w.start < *b)).count() * 2 >= r.len(),
+        None => !have.is_empty(),
+    };
+    if have_here && !bool_p(p, "retranscribe").unwrap_or(false) {
+        return Ok(None);
+    }
+    let q = s.active_sequence().ok_or(EngineError::NoSequence)?;
+    let mut per: std::collections::BTreeMap<u64, Vec<(Tick, Tick)>> = Default::default();
+    match &ranges {
+        Some(r) => {
+            for w in r {
+                collect_audio(&s.project, q, Some(*w), &mut per, 0);
+            }
+        }
+        None => collect_audio(&s.project, q, None, &mut per, 0),
+    }
+    let mut items = Vec::new();
+    let mut pre = Vec::new();
+    let mut paths = std::collections::HashMap::new();
+    let mut existing = std::collections::HashMap::new();
+    for (id, mut rs) in per {
+        let item = filmcraft_project::ItemId(id);
+        if !bool_p(p, "retranscribe").unwrap_or(false)
+            && let Some(tr) = jarvis_sidecar(s, item, &rs)
+        {
+            pre.push((item, tr));
+            continue;
+        }
+        let Some(src) = s.source(item) else { continue };
+        if !src.info().has_audio() {
+            continue;
+        }
+        rs.sort();
+        let mut merged: Vec<(Tick, Tick)> = Vec::new();
+        for (a, b) in rs {
+            match merged.last_mut() {
+                Some(l) if a <= l.1 + Tick::from_seconds_f64(1.0) => l.1 = l.1.max(b),
+                _ => merged.push((a, b)),
+            }
+        }
+        if let Some(filmcraft_project::ItemKind::Media(m)) = s.project.item(item).map(|x| &x.kind)
+            && let filmcraft_project::MediaRef::File { path } = &m.media
+        {
+            paths.insert(item.0, path.clone());
+        }
+        if let Some(old) = s.project.transcripts.get(&item) {
+            existing.insert(item.0, (old.clone(), merged.clone()));
+        }
+        items.push((item, src, merged));
+    }
+    if items.is_empty() && pre.is_empty() {
+        return Err(EngineError::Other("nessun audio nella sequenza".into()));
+    }
+    Ok(Some(CaptionJob {
+        pre,
+        paths,
+        existing,
+        items,
+        model: str_p(p, "model").unwrap_or("whisper-small").to_string(),
+        language: Some(str_p(p, "language").unwrap_or("it").to_string()).filter(|l| l != "auto"),
+        installed: s.transcriber.clone(),
+    }))
+}
+
+/// Fa la trascrizione (da chiamare in un thread). `progress(frazione, messaggio)`.
+pub fn run_captions(mut job: CaptionJob, progress: &(dyn Fn(f32, String) + Sync)) -> std::result::Result<Vec<(filmcraft_project::ItemId, filmcraft_project::Transcript)>, String> {
+    let existing = std::mem::take(&mut job.existing);
+    let out = run_captions_inner(job, progress)?;
+    // le parole vecchie fuori dai tratti appena trascritti restano
+    Ok(out
+        .into_iter()
+        .map(|(item, mut tr)| {
+            if let Some((old, rs)) = existing.get(&item.0) {
+                let keep = old.words.iter().filter(|w| !rs.iter().any(|(a, b)| w.start >= *a && w.start < *b)).cloned();
+                tr.words.extend(keep);
+                tr.words.sort_by_key(|w| w.start);
+                tr.normalize();
+            }
+            (item, tr)
+        })
+        .collect())
+}
+
+fn run_captions_inner(mut job: CaptionJob, progress: &(dyn Fn(f32, String) + Sync)) -> std::result::Result<Vec<(filmcraft_project::ItemId, filmcraft_project::Transcript)>, String> {
+    let mut pre = std::mem::take(&mut job.pre);
+    // Jarvis Clipper installato: trascrive lui con la scheda video e il modello più preciso
+    if let Some(exe) = jarvis_exe() {
+        let n = job.items.len().max(1);
+        let mut rest = Vec::new();
+        for (k, (item, src, ranges)) in std::mem::take(&mut job.items).into_iter().enumerate() {
+            let got = job.paths.get(&item.0).and_then(|path| {
+                jarvis_transcribe(&exe, path, &ranges, job.language.as_deref().unwrap_or("it"), &|f, m| progress((k as f32 + f) / n as f32, m))
+            });
+            match got {
+                Some(tr) => pre.push((item, tr)),
+                None => rest.push((item, src, ranges)),
+            }
+        }
+        job.items = rest;
+    }
+    if job.items.is_empty() {
+        progress(1.0, "Trascrizione pronta".into());
+        return Ok(pre);
+    }
+    let t: std::sync::Arc<dyn filmcraft_speech::Transcriber> = match job.installed {
+        Some(t) => t,
+        None => {
+            let dir = crate::transcript::models_dir().ok_or("nessuna cartella per i modelli")?;
+            let m = filmcraft_speech::models::find(&job.model).ok_or("modello sconosciuto")?;
+            if !filmcraft_speech::models::installed(&dir, m) {
+                progress(0.0, "Scarico il modello di trascrizione (solo la prima volta)…".into());
+                #[cfg(feature = "speech-download")]
+                filmcraft_speech::models::download(&dir, m, &mut |a, b, _| {
+                    if b > 0 {
+                        progress(0.0, format!("Scarico il modello… {:.0}%", a as f64 * 100.0 / b as f64));
+                    }
+                    true
+                })
+                .map_err(|e| e.to_string())?;
+            }
+            progress(0.0, "Carico il modello…".into());
+            filmcraft_speech::load(&dir, &job.model).map_err(|e| e.to_string())?
+        }
+    };
+    let opts = filmcraft_speech::Options { language: job.language.clone(), diarize: false, ..Default::default() };
+    let sr = filmcraft_speech::SAMPLE_RATE as i64;
+    let total: f64 = job.items.iter().flat_map(|(_, _, r)| r.iter()).map(|(a, b)| (b.0 - a.0) as f64).sum::<f64>().max(1.0);
+    let mut done = 0.0f64;
+    let mut out = pre;
+    for (item, src, ranges) in job.items {
+        let mut words = Vec::new();
+        let mut lang = job.language.clone().unwrap_or_else(|| "it".into());
+        for (a, b) in ranges {
+            // a pezzi da ~2 minuti: meno memoria e avanzamento più fluido
+            let step = Tick::from_seconds_f64(120.0);
+            let mut c = a;
+            while c < b {
+                let e = (c + step).min(b);
+                let start = c.to_units_floor(sr).max(0);
+                let len = (e - c).to_units_floor(sr).max(0) as usize;
+                if len > sr as usize / 4 {
+                    let buf = src.audio(start, len, filmcraft_speech::SAMPLE_RATE).map_err(|e| e.to_string())?;
+                    let mono = filmcraft_speech::downmix(&buf.channels);
+                    let base = done;
+                    let span = (e.0 - c.0) as f64;
+                    let mut pf = |f: f32, _m: &str| {
+                        progress(((base + span * f as f64) / total) as f32, format!("Trascrivo… {:.0}%", (base + span * f as f64) / total * 100.0));
+                        true
+                    };
+                    let tr = t.transcribe(&mono, &opts, &mut pf).map_err(|e| e.to_string())?;
+                    lang = tr.language.clone();
+                    for mut w in tr.words {
+                        w.start = w.start + c;
+                        w.end = w.end + c;
+                        words.push(w);
+                    }
+                }
+                done += (e.0 - c.0) as f64;
+                progress((done / total) as f32, format!("Trascrivo… {:.0}%", done / total * 100.0));
+                c = e;
+            }
+        }
+        drop_hallucinations(&mut words);
+        let mut tr = filmcraft_project::Transcript { language: lang, source: t.id(), speakers: Vec::new(), words };
+        tr.normalize();
+        out.push((item, tr));
+    }
+    Ok(out)
+}
+
+/// Salva le trascrizioni fatte in background (una modifica annullabile).
+pub fn apply_transcripts(s: &mut Session, done: Vec<(filmcraft_project::ItemId, filmcraft_project::Transcript)>) -> Result<()> {
+    let seq_id = s.state.active_sequence;
+    s.edit("Trascrizione Jarvis", move |pr, _| {
+        for (i, t) in done {
+            pr.transcripts.insert(i, std::sync::Arc::new(t));
+        }
+        // le sequenze annidate: la loro trascrizione è quella di quello che c'è dentro
+        let mut nests = Vec::new();
+        if let Some(q) = seq_id.and_then(|id| pr.sequence(id)) {
+            find_nests(pr, q, &mut nests, 0);
+        }
+        for (id, inner) in nests {
+            let words: Vec<filmcraft_project::Word> = filmcraft_edit::transcript::sequence_words(&inner, &pr.transcripts)
+                .into_iter()
+                .map(|w| filmcraft_project::Word::new(w.text, w.start, w.end))
+                .collect();
+            if !words.is_empty() {
+                let mut tr = filmcraft_project::Transcript { language: "it".into(), source: "jarvis-nest".into(), speakers: Vec::new(), words };
+                tr.normalize();
+                pr.transcripts.insert(id, std::sync::Arc::new(tr));
+            }
+        }
+        Ok(())
+    })
+}
