+fn composer_library_ui(st: &mut State, ui: &mut egui::Ui, ctx: &egui::Context, run: &mut Option<(String, Value, String)>) {
+    let lib = filmcraft_engine::jarvis::composer_library();
+    ui.horizontal(|ui| {
+        ui.heading("🎞 Premiere Composer");
+        if ui.button("📥 Importa preset Premiere…").on_hover_text("Scegli un file .prfpset (i tuoi preset di Premiere): finiscono in Effetti › Preset").clicked() {
+            *run = Some(("jarvis.importPresets".into(), json!({}), String::new()));
+        }
+    });
+    if lib.is_empty() {
+        ui.small("Premiere Composer non è installato su questo PC: qui compaiono le sue transizioni quando c'è.");
+        return;
+    }
+    let mut cats: Vec<String> = Vec::new();
+    for it in lib.iter() {
+        if !cats.contains(&it.category) {
+            cats.push(it.category.clone());
+        }
+    }
+    if st.mh_cat.is_empty() || !cats.contains(&st.mh_cat) {
+        st.mh_cat = cats[0].clone();
+    }
+    ui.small("Clic: sul taglio vicino all'indicatore · trascina sulla Timeline: sul taglio dove la lasci");
+    ui.horizontal_top(|ui| {
+        ui.vertical(|ui| {
+            ui.set_width(130.0);
+            for c in &cats {
+                if ui.selectable_label(*c == st.mh_cat, c).clicked() {
+                    st.mh_cat = c.clone();
+                }
+            }
+        });
+        ui.separator();
+        ui.vertical(|ui| {
+            let items: Vec<&filmcraft_engine::jarvis::MhItem> = lib.iter().filter(|i| i.category == st.mh_cat).collect();
+            let cols = ((ui.available_width() / 150.0).floor() as usize).max(1);
+            egui::Grid::new("jarvis_mh_grid").spacing([8.0, 8.0]).show(ui, |ui| {
+                for (k, it) in items.iter().enumerate() {
+                    let tex = it.thumb.as_ref().and_then(|p| thumb(st, ctx, p));
+                    let r = ui.vertical(|ui| {
+                        let size = egui::vec2(140.0, 79.0);
+                        let resp = match &tex {
+                            Some(t) => ui.add(egui::Image::new((t.id(), size)).sense(egui::Sense::click_and_drag())),
+                            None => ui.add_sized(size, egui::Button::new("▶").sense(egui::Sense::click_and_drag())),
+                        };
+                        ui.add_sized([140.0, 14.0], egui::Label::new(egui::RichText::new(&it.name).small()).truncate());
+                        resp
+                    });
+                    let resp = r.inner.on_hover_text(&it.name);
+                    let base = json!({"path": it.path.to_string_lossy(), "scope": SCOPES[st.scope].0, "sfx": st.sfx, "sfxGain": st.sfx_gain + 3.0});
+                    if resp.clicked() {
+                        *run = Some(("jarvis.composerItem".into(), base.clone(), String::new()));
+                    }
+                    if resp.drag_started() || (resp.dragged() && st.mh_drag.is_none()) {
+                        st.mh_drag = Some((it.name.clone(), base.clone()));
+                    }
+                    if (k + 1) % cols == 0 {
+                        ui.end_row();
+                    }
+                }
+            });
+        });
+    });
+}
