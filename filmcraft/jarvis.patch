+// ---------------------------------------------------------------- libreria Premiere Composer
+// Le transizioni di Premiere Composer (Mister Horse) installate sul PC dell'utente: ogni file
+// `.mhpctransition` è un progetto Premiere (gzip) con livelli di regolazione su più tracce, divisi
+// sul punto del taglio, e uno swoosh. Si leggono così come sono e si rifanno in FilmCraft: stessi
+// effetti e keyframe (convertiti con il lettore dei preset Premiere), stesso suono.
+
+pub const COMPOSER_TRACK: &str = "Composer";
+
+#[derive(Clone, Debug)]
+pub struct MhItem {
+    pub name: String,
+    pub category: String,
+    pub path: std::path::PathBuf,
+    pub thumb: Option<std::path::PathBuf>,
+}
+
+fn strip_num(s: &str) -> String {
+    let t = s.trim();
+    let t = if t.starts_with('(') { t.find(')').map(|i| t[i + 1..].trim()).unwrap_or(t) } else { t };
+    t.replace("[$", "[").to_string()
+}
+
+/// Le transizioni Composer installate (ordinate per categoria e nome).
+pub fn composer_library() -> &'static Vec<MhItem> {
+    static LIB: std::sync::OnceLock<Vec<MhItem>> = std::sync::OnceLock::new();
+    LIB.get_or_init(|| {
+        let mut out = Vec::new();
+        let Some(la) = std::env::var_os("LOCALAPPDATA").map(std::path::PathBuf::from) else { return out };
+        let products = la.join("MisterHorse").join("ProductManager").join("Products");
+        let mut stack = vec![(products, 0usize)];
+        while let Some((d, depth)) = stack.pop() {
+            let Ok(rd) = std::fs::read_dir(&d) else { continue };
+            for e in rd.flatten() {
+                let p = e.path();
+                if p.is_dir() {
+                    if depth < 6 {
+                        stack.push((p, depth + 1));
+                    }
+                } else if p.extension().and_then(|x| x.to_str()) == Some("mhpctransition") {
+                    let stem = p.file_stem().map(|x| x.to_string_lossy().to_string()).unwrap_or_default();
+                    let thumb = p.with_file_name(format!("{stem}.mhpreview.png"));
+                    let category = p.parent().and_then(|x| x.file_name()).map(|x| strip_num(&x.to_string_lossy())).unwrap_or_default();
+                    out.push(MhItem { name: strip_num(&stem), category, thumb: thumb.exists().then_some(thumb), path: p.clone() });
+                }
+            }
+        }
+        out.sort_by(|a, b| (a.category.clone(), a.path.clone()).cmp(&(b.category.clone(), b.path.clone())));
+        out
+    })
+}
+
+/// Una transizione letta: tracce di pezzi (inizio, fine, effetti), suoni, punto del taglio.
+pub struct MhTransition {
+    pub split: Tick,
+    pub tracks: Vec<Vec<(Tick, Tick, Vec<filmcraft_project::EffectInstance>)>>,
+    pub audio: Vec<(std::path::PathBuf, Tick)>,
+}
+
+fn txt<'a>(n: roxmltree::Node<'a, '_>, tag: &str) -> Option<&'a str> {
+    n.descendants().find(|c| c.tag_name().name() == tag).and_then(|c| c.text())
+}
+
+fn scale_points(e: &mut filmcraft_project::EffectInstance, sx: f64, sy: f64) {
+    if (sx - 1.0).abs() < 1e-9 && (sy - 1.0).abs() < 1e-9 {
+        return;
+    }
+    for p in e.params.values_mut() {
+        p.map_values(|v| match v {
+            ParamValue::Vec2(q) if q.x.is_finite() && q.y.is_finite() => ParamValue::Vec2(Vec2::new(q.x * sx, q.y * sy)),
+            other => other,
+        });
+    }
+}
+
+pub fn load_mh(path: &std::path::Path, frame: (u32, u32)) -> std::result::Result<MhTransition, String> {
+    use std::io::Read;
+    let raw = std::fs::read(path).map_err(|e| e.to_string())?;
+    let mut text = String::new();
+    if raw.starts_with(&[0x1f, 0x8b]) {
+        flate2::read::GzDecoder::new(&raw[..]).read_to_string(&mut text).map_err(|e| e.to_string())?;
+    } else {
+        text = String::from_utf8_lossy(&raw).to_string();
+    }
+    let doc = roxmltree::Document::parse(&text).map_err(|e| e.to_string())?;
+    let mut objects: crate::prfpset::Objects<'_, '_> = std::collections::HashMap::new();
+    let mut uobjects: std::collections::HashMap<&str, roxmltree::Node<'_, '_>> = std::collections::HashMap::new();
+    for n in doc.descendants() {
+        if let Some(id) = n.attribute("ObjectID") {
+            objects.insert(id, n);
+        }
+        if let Some(id) = n.attribute("ObjectUID") {
+            uobjects.insert(id, n);
+        }
+    }
+    fn rf<'a, 'i>(n: roxmltree::Node<'a, 'i>, tag: &str) -> Option<&'a str> {
+        n.descendants().find(|c| c.tag_name().name() == tag).and_then(|c| c.attribute("ObjectRef"))
+    }
+    // Composer è fatto a 1920x1080: i punti si riportano alla sequenza
+    let (sx, sy) = (frame.0 as f64 / 1920.0, frame.1 as f64 / 1080.0);
+    // tracce video nell'ordine del gruppo
+    let mut tracks = Vec::new();
+    if let Some(tg) = doc.descendants().find(|n| n.tag_name().name() == "VideoTrackGroup" && n.attribute("ObjectID").is_some()) {
+        let mut refs: Vec<(usize, &str)> = tg
+            .descendants()
+            .filter(|n| n.tag_name().name() == "Track" && n.attribute("ObjectURef").is_some())
+            .map(|n| (n.attribute("Index").and_then(|i| i.parse().ok()).unwrap_or(0), n.attribute("ObjectURef").unwrap_or("")))
+            .collect();
+        refs.sort();
+        for (_, uref) in refs {
+            let Some(track) = uobjects.get(uref) else { continue };
+            let mut pieces = Vec::new();
+            for ti in track.descendants().filter(|n| n.tag_name().name() == "TrackItem" && n.attribute("ObjectRef").is_some()) {
+                let Some(item) = ti.attribute("ObjectRef").and_then(|r| objects.get(r)).copied() else { continue };
+                let start = txt(item, "Start").and_then(|v| v.parse::<i64>().ok()).unwrap_or(0);
+                let end = txt(item, "End").and_then(|v| v.parse::<i64>().ok()).unwrap_or(start);
+                // in-point della clip (i keyframe sono contati da lì)
+                let anchor_in = rf(item, "SubClip")
+                    .and_then(|r| objects.get(r))
+                    .and_then(|sc| rf(*sc, "Clip"))
+                    .and_then(|r| objects.get(r))
+                    .and_then(|c| txt(*c, "InPoint"))
+                    .and_then(|v| v.parse::<i64>().ok())
+                    .unwrap_or(0);
+                let mut effects = Vec::new();
+                if let Some(chain) = rf(item, "Components").and_then(|r| objects.get(r)) {
+                    for c in chain.descendants().filter(|n| n.tag_name().name() == "Component" && n.attribute("ObjectRef").is_some()) {
+                        let Some(comp) = c.attribute("ObjectRef").and_then(|r| objects.get(r)).copied() else { continue };
+                        let match_name = txt(comp, "MatchName").unwrap_or("").trim().to_string();
+                        let display = txt(comp, "DisplayName").unwrap_or("").trim().to_string();
+                        // i livelli grafici vuoti (Testo, Forma) e le maschere non servono
+                        if matches!(match_name.as_str(), "AE.ADBE Text" | "AE.ADBE Shape" | "AE.ADBE AEMask") {
+                            continue;
+                        }
+                        let Some(eid) = crate::prfpset::resolve_effect(&match_name, &display) else { continue };
+                        if eid == "motion" || eid == "opacity" {
+                            continue;
+                        }
+                        if let Ok((mut inst, _)) = crate::prfpset::parse_component(eid, &match_name, comp, anchor_in, &objects) {
+                            scale_points(&mut inst, sx, sy);
+                            effects.push(inst);
+                        }
+                    }
+                }
+                // nel progetto Premiere la catena è salvata dall'ultimo effetto al primo
+                effects.reverse();
+                pieces.push((Tick(start), Tick(end), effects));
+            }
+            if !pieces.is_empty() {
+                pieces.sort_by_key(|p| p.0);
+                tracks.push(pieces);
+            }
+        }
+    }
+    if tracks.is_empty() {
+        return Err("nessun livello nella transizione".into());
+    }
+    // il taglio: dove si dividono i pezzi
+    let split = tracks.iter().find(|t| t.len() > 1).map(|t| t[0].1).unwrap_or_else(|| Tick(tracks[0][0].1 .0 / 2));
+    // suoni: percorsi ___MH_PATH___ = cartella Assets del prodotto
+    let assets = path.ancestors().find(|a| a.join("Assets").is_dir()).map(|a| a.join("Assets"));
+    let mut audio = Vec::new();
+    for item in doc.descendants().filter(|n| n.tag_name().name() == "AudioClipTrackItem" && n.attribute("ObjectID").is_some()) {
+        let start = txt(item, "Start").and_then(|v| v.parse::<i64>().ok()).unwrap_or(0);
+        let media = rf(item, "SubClip").and_then(|r| objects.get(r)).and_then(|sc| rf(*sc, "Clip")).and_then(|r| objects.get(r));
+        let _ = media;
+        let p = doc
+            .descendants()
+            .filter(|n| n.tag_name().name() == "ActualMediaFilePath")
+            .filter_map(|n| n.text())
+            .find(|t| t.starts_with("___MH_PATH___"))
+            .map(|t| t.trim_start_matches("___MH_PATH___").to_string());
+        if let (Some(rel), Some(a)) = (p, &assets) {
+            let f = a.join(rel.replace('/', std::path::MAIN_SEPARATOR_STR));
+            if f.exists() {
+                audio.push((f, Tick(start)));
+            }
+        }
+    }
+    Ok(MhTransition { split, tracks, audio })
+}
+
+fn mh_apply(s: &mut Session, p: &Value) -> Result<Value> {
+    let path = std::path::PathBuf::from(str_p(p, "path").ok_or_else(|| bad("jarvis.composerItem", "manca il file"))?);
+    let (w, h, rate) = {
+        let q = s.active_sequence().ok_or(EngineError::NoSequence)?;
+        (q.settings.width, q.settings.height, q.settings.frame_rate)
+    };
+    let mh = load_mh(&path, (w, h)).map_err(EngineError::Other)?;
+    // dove: il taglio vicino a `time` (trascinamento) o all'indicatore, oppure i tagli della selezione
+    let times: Vec<Tick> = if let Some(t) = p.get("time").and_then(Value::as_i64).map(Tick) {
+        let q = s.active_sequence().ok_or(EngineError::NoSequence)?;
+        let cuts: Vec<Tick> = q.video_tracks.iter().filter(|tr| tr.name != CAPTION_TRACK && !tr.name.starts_with(COMPOSER_TRACK)).flat_map(|tr| {
+            tr.items.windows(2).filter(|w| w[0].end() == w[1].start).map(|w| w[1].start).collect::<Vec<_>>()
+        }).collect();
+        vec![cuts.into_iter().min_by_key(|c| (c.0 - t.0).abs()).unwrap_or(t)]
+    } else {
+        let v = cut_times(s, str_p(p, "scope").unwrap_or("playhead"));
+        if v.is_empty() { vec![s.playhead()] } else { v }
+    };
+    let seq_id = s.state.active_sequence.ok_or(EngineError::NoSequence)?;
+    let n = s.edit("Transizione Composer", |pr, _st| {
+        let adj = pr.items.iter().find(|(_, i)| i.name == "Composer (Jarvis)" && matches!(i.kind, filmcraft_project::ItemKind::AdjustmentLayer { .. })).map(|(id, _)| *id);
+        let adj = match adj {
+            Some(a) => a,
+            None => pr.add_item(
+                "Composer (Jarvis)",
+                filmcraft_project::Label::Lavender,
+                filmcraft_project::ItemKind::AdjustmentLayer { width: w, height: h, rate, duration: Tick::from_seconds_f64(36_000.0) },
+                None,
+            ),
+        };
+        let mut placed: Vec<(usize, filmcraft_project::TrackItem)> = Vec::new();
+        for c in &times {
+            let off = Tick(c.0 - mh.split.0);
+            for (j, pieces) in mh.tracks.iter().enumerate() {
+                for (a, b, fx) in pieces {
+                    let start = rate.snap_nearest(Tick((a.0 + off.0).max(0)));
+                    let end = rate.snap_nearest(Tick((b.0 + off.0).max(0)));
+                    let dur = Tick(end.0 - start.0).max(rate.frame_duration());
+                    let Some(mut ti) = pr.make_track_item(adj, TrackKind::Video, start, TimeRange::new(Tick::ZERO, dur), rate) else { continue };
+                    ti.name = path.file_stem().map(|x| strip_num(&x.to_string_lossy())).unwrap_or_default();
+                    ti.effects.extend(fx.iter().cloned());
+                    placed.push((j, ti));
+                }
+            }
+        }
+        let mut ids: Vec<TrackId> = (0..8).map(|_| TrackId(pr.alloc_id())).collect();
+        let q = pr.sequence_mut(seq_id).ok_or(EngineError::NoSequence)?;
+        let n = placed.len();
+        let mut row_track: std::collections::HashMap<(usize, i64), usize> = Default::default();
+        for (j, ti) in placed {
+            let range = ti.range();
+            let key = (j, range.start.0 / 1_000_000_000_000);
+            let free = |tr: &Track| !tr.items.iter().any(|i| i.range().overlaps(&range));
+            let idx = match row_track.get(&key).copied().filter(|&i| free(&q.video_tracks[i])) {
+                Some(i) => i,
+                None => {
+                    let top = q.video_tracks.iter().rposition(|tr| tr.name != CAPTION_TRACK && tr.items.iter().any(|i| i.range().overlaps(&range))).map_or(0, |k| k + 1);
+                    let found = (top..q.video_tracks.len()).find(|&i| q.video_tracks[i].name.starts_with(COMPOSER_TRACK) && free(&q.video_tracks[i]) && !row_track.values().any(|&v| v == i && false));
+                    match found {
+                        Some(i) if j == 0 || row_track.get(&(j - 1, key.1)).is_none_or(|&prev| i > prev) => i,
+                        _ => {
+                            let id = ids.pop().unwrap_or(TrackId(0));
+                            let name = format!("{COMPOSER_TRACK} {}", q.video_tracks.iter().filter(|t| t.name.starts_with(COMPOSER_TRACK)).count() + 1);
+                            // sotto la traccia dei sottotitoli, se c'è
+                            let at = q.video_tracks.iter().position(|t| t.name == CAPTION_TRACK).unwrap_or(q.video_tracks.len());
+                            q.video_tracks.insert(at, Track::new(id, TrackKind::Video, name));
+                            for v in row_track.values_mut() {
+                                if *v >= at {
+                                    *v += 1;
+                                }
+                            }
+                            at
+                        }
+                    }
+                }
+            };
+            row_track.insert(key, idx);
+            q.video_tracks[idx].items.push(ti);
+            q.video_tracks[idx].sort();
+        }
+        q.check().map_err(EngineError::Other)?;
+        Ok(n)
+    })?;
+    let mut sfx = 0;
+    if bool_p(p, "sfx").unwrap_or(true) && !mh.audio.is_empty() {
+        let sounds: Vec<_> = times.iter().flat_map(|c| mh.audio.iter().map(move |(f, st)| (f.clone(), Tick((c.0 - mh.split.0 + st.0).max(0))))).collect();
+        sfx = place_sfx(s, sounds, f64_p(p, "sfxGain").unwrap_or(0.0))?;
+    }
+    Ok(json!({"layers": n, "transitions": times.len(), "sfx": sfx}))
+}
+
+
+// ---------------------------------------------------------------- titoli TikTok
+
+pub const TITLE_TRACK: &str = "Titoli TikTok";
+
+/// Mette il PNG del titolo (grande come la sequenza) sulla traccia "Titoli TikTok" all'indicatore.
+fn place_title(s: &mut Session, p: &Value) -> Result<Value> {
+    let path = str_p(p, "path").ok_or_else(|| bad("jarvis.placeTitle", "manca il file"))?.to_string();
+    let seq_id = s.state.active_sequence.ok_or(EngineError::NoSequence)?;
+    let rate = s.sequence_rate();
+    let at = p["time"].as_i64().map(Tick).unwrap_or_else(|| s.playhead());
+    let dur = Tick::from_seconds_f64(f64_p(p, "seconds").unwrap_or(3.0).clamp(0.2, 600.0));
+    let item = match media_with_path(s, &path) {
+        Some(i) => i,
+        None => {
+            let r = s.execute("file.import", json!({"paths": [path.clone()]}))?;
+            r["items"].as_array().and_then(|a| a.first()).and_then(Value::as_u64).map(filmcraft_project::ItemId).ok_or_else(|| bad("jarvis.placeTitle", "non riesco a importare il titolo"))?
+        }
+    };
+    let clip = s.edit("Titolo TikTok", |pr, _st| {
+        let t = rate.snap(at.max(Tick::ZERO));
+        let mut ti = pr.make_track_item(item, TrackKind::Video, t, TimeRange::new(Tick::ZERO, rate.snap(dur)), rate).ok_or_else(|| EngineError::Other("titolo non valido".into()))?;
+        ti.name = std::path::Path::new(&path).file_stem().map(|x| x.to_string_lossy().to_string()).unwrap_or_else(|| "Titolo".into());
+        let id = ti.id;
+        let tid = TrackId(pr.alloc_id());
+        let q = pr.sequence_mut(seq_id).ok_or(EngineError::NoSequence)?;
+        let range = ti.range();
+        let free = |tr: &Track| !tr.items.iter().any(|i| i.range().overlaps(&range));
+        let idx = match q.video_tracks.iter().position(|tr| tr.name == TITLE_TRACK && free(tr)) {
+            Some(i) => i,
+            None => {
+                // sopra a tutto, tranne i sottotitoli che restano in cima
+                let at = q.video_tracks.iter().position(|tr| tr.name == CAPTION_TRACK).unwrap_or(q.video_tracks.len());
+                q.video_tracks.insert(at, Track::new(tid, TrackKind::Video, TITLE_TRACK.to_string()));
+                at
+            }
+        };
+        q.video_tracks[idx].items.push(ti);
+        q.video_tracks[idx].sort();
+        q.check().map_err(EngineError::Other)?;
+        Ok(id)
+    })?;
+    s.state.selection = vec![clip].into_iter().collect();
+    Ok(json!({"clip": clip.0}))
+}
