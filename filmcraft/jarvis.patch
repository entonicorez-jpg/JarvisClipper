+fn done_msg(cmd: &str, v: &Value) -> String {
+    match cmd {
+        "jarvis.autoCaptions" => format!("✅ Creati {} pezzi di sottotitoli", v["captions"].as_u64().unwrap_or(0)),
+        "jarvis.transition" | "jarvis.composer" => format!("✅ Transizioni messe: {} · suoni: {}", v["transitions"].as_u64().unwrap_or(0), v["sfx"].as_u64().unwrap_or(0)),
+        "jarvis.clipFx" => format!("✅ Effetto applicato a {} clip", v["clips"].as_u64().unwrap_or(0)),
+        "jarvis.composerItem" => format!("✅ Transizione Composer: {} livelli · suoni: {}", v["layers"].as_u64().unwrap_or(0), v["sfx"].as_u64().unwrap_or(0)),
+        _ => "✅ Fatto".into(),
+    }
+}
