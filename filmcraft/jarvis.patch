+fn ago(t: std::time::SystemTime) -> String {
+    let s = std::time::SystemTime::now().duration_since(t).map(|d| d.as_secs()).unwrap_or(0);
+    match s {
+        0..=59 => "adesso".into(),
+        60..=3599 => format!("{} min fa", s / 60),
+        3600..=86_399 => format!("{} ore fa", s / 3600),
+        86_400..=172_799 => "ieri".into(),
+        _ => format!("{} giorni fa", s / 86_400),
+    }
+}
