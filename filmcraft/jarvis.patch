+pub struct TransPreset {
+    pub id: &'static str,
+    pub name: &'static str,
+    pub effect: &'static str,
+    pub frames: i64,
+}
+
+pub const TRANSITIONS: &[TransPreset] = &[
+    TransPreset { id: "zoom_blur", name: "Zoom blur", effect: "zoom_blur", frames: 8 },
+    TransPreset { id: "whip", name: "Whip (frusta)", effect: "whip", frames: 6 },
+    TransPreset { id: "cross_zoom", name: "Cross zoom", effect: "cross_zoom", frames: 10 },
+    TransPreset { id: "spin", name: "Spin con blur", effect: "spin_motion", frames: 10 },
+    TransPreset { id: "push", name: "Push con blur", effect: "push", frames: 8 },
+    TransPreset { id: "shake", name: "Terremoto", effect: "earthquake", frames: 8 },
+    TransPreset { id: "glitch", name: "Glitch", effect: "glitch", frames: 6 },
+    TransPreset { id: "flash", name: "Flash bianco", effect: "flash", frames: 6 },
+    TransPreset { id: "light_leak", name: "Light leak", effect: "light_leak", frames: 14 },
+    TransPreset { id: "vhs", name: "VHS", effect: "vhs_damage", frames: 8 },
+    TransPreset { id: "dissolve", name: "Dissolvenza", effect: "cross_dissolve", frames: 10 },
+];
+
+const MIX: &[&str] = &["zoom_blur", "whip", "cross_zoom", "push", "flash"];
+
+/// I tagli (clip di sinistra) su cui mettere la transizione.
+fn edit_points(s: &Session, scope: &str) -> Vec<ClipId> {
+    let Some(q) = s.active_sequence() else { return Vec::new() };
+    let t = s.playhead();
+    let half = Tick(s.sequence_rate().frame_duration().0 / 2);
+    let tracks: Vec<&Track> = q.video_tracks.iter().filter(|tr| tr.name != CAPTION_TRACK).collect();
+    let joined = |tr: &Track, i: usize| tr.items.get(i + 1).is_some_and(|n| n.start == tr.items[i].end());
+    let mut out = Vec::new();
+    match scope {
+        "selection" => {
+            for tr in &tracks {
+                for i in 0..tr.items.len() {
+                    if s.state.selection.contains(&tr.items[i].id) && joined(tr, i) {
+                        out.push(tr.items[i].id);
+                    }
+                }
+            }
+        }
+        "all" => {
+            if let Some(tr) = tracks.first() {
+                out.extend((0..tr.items.len()).filter(|&i| joined(tr, i)).map(|i| tr.items[i].id));
+            }
+        }
+        _ => {
+            // il taglio più vicino all'indicatore, sulla traccia più bassa che ne ha uno
+            for tr in &tracks {
+                if let Some(i) = (0..tr.items.len()).filter(|&i| joined(tr, i)).min_by_key(|&i| (tr.items[i].end() - t).0.abs()) {
+                    if (tr.items[i].end() - t).0.abs() <= half.0 * 2 + s.sequence_rate().frame_duration().0 * 12 {
+                        out.push(tr.items[i].id);
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    out
+}
+
+fn transition(s: &mut Session, p: &Value) -> Result<Value> {
+    let pid = str_p(p, "preset").unwrap_or("zoom_blur").to_string();
+    let scope = str_p(p, "scope").unwrap_or("playhead").to_string();
+    let clips = edit_points(s, &scope);
+    if clips.is_empty() {
+        return Err(bad("jarvis.transition", "nessun taglio qui: metti l'indicatore su un taglio o seleziona le clip"));
+    }
+    let mut done = 0;
+    let mut last_err = None;
+    for (k, c) in clips.iter().enumerate() {
+        let id = if pid == "mix" { MIX[k % MIX.len()] } else { pid.as_str() };
+        let Some(tp) = TRANSITIONS.iter().find(|x| x.id == id) else { return Err(bad("jarvis.transition", "preset sconosciuto")) };
+        let frames = u64_p(p, "frames").map(|v| v as i64).unwrap_or(tp.frames);
+        let mut ok = false;
+        for align in ["center", "end", "start"] {
+            match s.execute("sequence.applyVideoTransition", json!({"clip": c.0, "effect": tp.effect, "frames": frames, "edge": "out", "align": align})) {
+                Ok(_) => {
+                    ok = true;
+                    break;
+                }
+                Err(e) => last_err = Some(e.to_string()),
+            }
+        }
+        done += usize::from(ok);
+    }
+    if done == 0 {
+        return Err(EngineError::Other(last_err.unwrap_or_else(|| "transizione non applicata".into())));
+    }
+    let mut sfx = 0;
+    if bool_p(p, "sfx").unwrap_or(true) {
+        let fd = s.sequence_rate().frame_duration();
+        let q = s.active_sequence();
+        let sounds: Vec<_> = clips
+            .iter()
+            .enumerate()
+            .filter_map(|(k, c)| {
+                let id = if pid == "mix" { MIX[k % MIX.len()] } else { pid.as_str() };
+                let tp = TRANSITIONS.iter().find(|x| x.id == id)?;
+                let t = q?.find_item(*c)?.1.end();
+                let f = pick_sfx(sfx_kind(id)?, k)?;
+                Some((f, Tick((t.0 - fd.0 * tp.frames / 2).max(0))))
+            })
+            .collect();
+        sfx = place_sfx(s, sounds, f64_p(p, "sfxGain").unwrap_or(-3.0))?;
+    }
+    Ok(json!({"transitions": done, "sfx": sfx}))
+}
