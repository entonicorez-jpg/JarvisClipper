diff --git a/crates/ui-egui/src/jarvis_titles.rs b/crates/ui-egui/src/jarvis_titles.rs
new file mode 100644
index 0000000..9c8196e
--- /dev/null
+++ b/crates/ui-egui/src/jarvis_titles.rs
@@ -0,0 +1,365 @@
+//! Jarvis Composer › Titoli TikTok: scrivi la frase, scegli le emoji dell'iPhone, e il titolo (testo
+//! bianco con bordo nero, font TikTok Sans, emoji a colori) va nella timeline come PNG grande come la
+//! sequenza, sulla traccia "Titoli TikTok". Il disegno lo fa Jarvis Clipper (`--tiktok-title`), che
+//! la prima volta scarica anche le emoji (`--emoji-setup`).
+
+use std::sync::{Arc, Mutex};
+
+use serde_json::{Value, json};
+
+/// Le emoji più usate nei titoli.
+const QUICK: &[&str] = &["💀", "☠️", "😭", "😂", "🔥", "😱", "😳", "🤯", "🤬", "👀", "🗿", "🤡", "❗", "🚨", "💯", "✨"];
+
+type Job = Arc<Mutex<Option<Result<String, String>>>>;
+
+pub(crate) struct Titles {
+    text: String,
+    upper: bool,
+    size: f32,
+    stroke: f32,
+    emoji: f32,
+    y: f32,
+    secs: f32,
+    query: String,
+    cat: usize,
+    /// indice delle emoji: (varianti, nomi, categoria) e nomi delle categorie
+    index: Option<(Vec<(Vec<String>, String, usize)>, Vec<String>, usize, usize)>,
+    atlas: Option<egui::TextureHandle>,
+    setup: Option<Job>,
+    setup_failed: bool,
+    preview: Option<(String, egui::TextureHandle)>,
+    preview_job: Option<(String, Job)>,
+    preview_wanted: Option<(String, f64)>,
+    add_job: Option<Job>,
+    msg: String,
+}
+
+impl Default for Titles {
+    fn default() -> Self {
+        Self {
+            text: String::new(),
+            upper: false,
+            size: 86.0,
+            stroke: 10.0,
+            emoji: 1.0,
+            y: 18.0,
+            secs: 3.0,
+            query: String::new(),
+            cat: 0,
+            index: None,
+            atlas: None,
+            setup: None,
+            setup_failed: false,
+            preview: None,
+            preview_job: None,
+            preview_wanted: None,
+            add_job: None,
+            msg: String::new(),
+        }
+    }
+}
+
+fn cache_dir() -> Option<std::path::PathBuf> {
+    std::env::var_os("LOCALAPPDATA").map(|l| std::path::PathBuf::from(l).join("JarvisClipper").join("titoli"))
+}
+
+fn spawn(args: Vec<std::ffi::OsString>, out: std::path::PathBuf) -> Job {
+    let job: Job = Arc::new(Mutex::new(None));
+    let j = job.clone();
+    std::thread::spawn(move || {
+        let r = (|| -> Result<String, String> {
+            let exe = filmcraft_engine::jarvis::jarvis_exe().ok_or("Installa o aggiorna Jarvis Clipper: serve per i titoli")?;
+            let mut cmd = std::process::Command::new(exe);
+            cmd.args(&args);
+            #[cfg(windows)]
+            {
+                use std::os::windows::process::CommandExt;
+                cmd.creation_flags(0x0800_0000);
+            }
+            let st = cmd.status().map_err(|e| e.to_string())?;
+            if st.success() { Ok(out.to_string_lossy().to_string()) } else { Err("Jarvis Clipper non è riuscito a creare il titolo (aggiornalo)".into()) }
+        })();
+        if let Ok(mut g) = j.lock() {
+            *g = Some(r);
+        }
+    });
+    job
+}
+
+fn take(job: &Option<Job>) -> Option<Result<String, String>> {
+    job.as_ref().and_then(|j| j.lock().ok().and_then(|mut g| g.take()))
+}
+
+impl Titles {
+    fn job(&self, w: u32, h: u32) -> Value {
+        json!({"text": self.text, "upper": self.upper, "size": self.size, "stroke": self.stroke, "emoji": self.emoji,
+               "y": self.y / 100.0, "w": w, "h": h, "shadow": true})
+    }
+
+    fn load_index(&mut self, ctx: &egui::Context) {
+        let Some(dir) = cache_dir() else { return };
+        if self.index.is_none()
+            && let Ok(txt) = std::fs::read_to_string(dir.join("emoji.json"))
+            && let Ok(v) = serde_json::from_str::<Value>(&txt)
+        {
+            let items = v["items"]
+                .as_array()
+                .map(|a| {
+                    a.iter()
+                        .map(|e| {
+                            let u: Vec<String> = e["u"].as_array().map(|x| x.iter().filter_map(|s| s.as_str().map(str::to_string)).collect()).unwrap_or_default();
+                            (u, e["n"].as_str().unwrap_or("").to_string(), e["c"].as_u64().unwrap_or(0) as usize)
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            let cats = v["cats"].as_array().map(|a| a.iter().filter_map(|s| s.as_str().map(str::to_string)).collect()).unwrap_or_default();
+            self.index = Some((items, cats, v["cols"].as_u64().unwrap_or(48) as usize, v["psize"].as_u64().unwrap_or(40) as usize));
+        }
+        if self.atlas.is_none()
+            && let Ok(b) = std::fs::read(dir.join("emoji40.png"))
+            && let Ok(img) = image::load_from_memory(&b)
+        {
+            let rgba = img.to_rgba8();
+            let size = [rgba.width() as usize, rgba.height() as usize];
+            let ci = egui::ColorImage::from_rgba_unmultiplied(size, rgba.as_raw());
+            self.atlas = Some(ctx.load_texture("jarvis-emoji", ci, egui::TextureOptions::LINEAR));
+        }
+    }
+
+    fn uv(&self, i: usize) -> egui::Rect {
+        let (cols, rows) = match &self.index {
+            Some((items, _, cols, _)) => (*cols, items.len().div_ceil(*cols)),
+            None => (48, 40),
+        };
+        let (x, y) = ((i % cols) as f32, (i / cols) as f32);
+        egui::Rect::from_min_max(egui::pos2(x / cols as f32, y / rows as f32), egui::pos2((x + 1.0) / cols as f32, (y + 1.0) / rows as f32))
+    }
+
+    fn find(&self, e: &str) -> Option<usize> {
+        let (items, ..) = self.index.as_ref()?;
+        let bare = e.replace('\u{fe0f}', "");
+        items.iter().position(|(u, ..)| u.iter().any(|v| v == e || v.replace('\u{fe0f}', "") == bare))
+    }
+
+    /// Un'emoji cliccabile: la aggiunge al testo.
+    fn emoji_button(&mut self, ui: &mut egui::Ui, i: usize, size: f32) {
+        let Some(tex) = &self.atlas else { return };
+        let (r, resp) = ui.allocate_exact_size(egui::vec2(size, size), egui::Sense::click());
+        if resp.hovered() {
+            ui.painter().rect_filled(r, 4.0, ui.visuals().widgets.hovered.bg_fill);
+        }
+        ui.painter().image(tex.id(), r.shrink(2.0), self.uv(i), egui::Color32::WHITE);
+        let name = self.index.as_ref().map(|(it, ..)| it[i].1.clone()).unwrap_or_default();
+        if resp.on_hover_text(name).clicked()
+            && let Some(u) = self.index.as_ref().and_then(|(it, ..)| it[i].0.first().cloned())
+        {
+            self.text.push_str(&u);
+        }
+    }
+}
+
+/// La scheda. `seq` = (larghezza, altezza) della sequenza; `proj` = file del progetto. Ritorna il
+/// comando da eseguire (il titolo pronto da mettere nella timeline).
+pub(crate) fn tab(t: &mut Titles, ui: &mut egui::Ui, ctx: &egui::Context, seq: Option<(u32, u32)>, proj: Option<String>) -> Option<(String, Value, String)> {
+    let mut run = None;
+    ui.heading("🎬 Titoli TikTok");
+    if filmcraft_engine::jarvis::jarvis_exe().is_none() {
+        ui.label("Serve Jarvis Clipper aggiornato (disegna lui i titoli con il font di TikTok e le emoji dell'iPhone).");
+        return None;
+    }
+    // emoji: la prima volta Jarvis le scarica
+    let ready = cache_dir().is_some_and(|d| d.join("emoji40.png").is_file() && d.join("emoji.json").is_file());
+    if ready {
+        t.load_index(ctx);
+    } else if t.setup.is_none() && !t.setup_failed {
+        let out = std::env::temp_dir().join("jarvis-emoji-setup.json");
+        t.setup = Some(spawn(vec!["--emoji-setup".into(), out.clone().into()], out));
+    }
+    if let Some(r) = take(&t.setup) {
+        t.setup = None;
+        if r.is_err() {
+            t.setup_failed = true;
+        }
+    }
+
+    ui.label("Testo");
+    let te = ui.add(egui::TextEdit::multiline(&mut t.text).desired_rows(2).desired_width(f32::INFINITY).hint_text("Minecraft con il suono al 1000% ☠️💀"));
+    if te.changed() {
+        t.preview_wanted = Some((String::new(), ctx.input(|i| i.time)));
+    }
+    if t.atlas.is_some() {
+        ui.horizontal_wrapped(|ui| {
+            for q in QUICK {
+                if let Some(i) = t.find(q) {
+                    t.emoji_button(ui, i, 30.0);
+                }
+            }
+        });
+        ui.add(egui::TextEdit::singleline(&mut t.query).hint_text("Cerca emoji (skull, fire, cry…)").desired_width(f32::INFINITY));
+        let cats = t.index.as_ref().map(|(_, c, ..)| c.clone()).unwrap_or_default();
+        ui.horizontal_wrapped(|ui| {
+            for (i, c) in cats.iter().enumerate() {
+                if ui.selectable_label(t.cat == i && t.query.is_empty(), c).clicked() {
+                    t.cat = i;
+                    t.query.clear();
+                }
+            }
+        });
+        let q = t.query.to_lowercase();
+        let list: Vec<usize> = t
+            .index
+            .as_ref()
+            .map(|(items, ..)| {
+                items
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, (_, n, c))| if q.is_empty() { *c == t.cat } else { q.split_whitespace().all(|w| n.contains(w)) })
+                    .map(|(i, _)| i)
+                    .collect()
+            })
+            .unwrap_or_default();
+        let cell = 30.0;
+        let per = ((ui.available_width() / cell).floor() as usize).max(1);
+        egui::ScrollArea::vertical().id_salt("jarvis-emoji-grid").max_height(170.0).show_rows(ui, cell, list.len().div_ceil(per), |ui, rows| {
+            for r in rows {
+                ui.horizontal(|ui| {
+                    ui.spacing_mut().item_spacing.x = 0.0;
+                    for &i in list.iter().skip(r * per).take(per) {
+                        t.emoji_button(ui, i, cell);
+                    }
+                });
+            }
+        });
+    } else if t.setup_failed {
+        ui.small("⚠ Non sono riuscito a scaricare le emoji (serve internet la prima volta). Puoi comunque scriverle con Win + .");
+    } else {
+        ui.horizontal(|ui| {
+            ui.spinner();
+            ui.small("Scarico le emoji dell'iPhone (solo la prima volta)…");
+        });
+        ctx.request_repaint_after(std::time::Duration::from_millis(500));
+    }
+
+    ui.add_space(4.0);
+    let mut changed = false;
+    ui.horizontal(|ui| {
+        changed |= ui.checkbox(&mut t.upper, "MAIUSCOLO").changed();
+        ui.label("Grandezza");
+        changed |= ui.add(egui::Slider::new(&mut t.size, 40.0..=160.0)).changed();
+    });
+    ui.horizontal(|ui| {
+        ui.label("Bordo");
+        changed |= ui.add(egui::Slider::new(&mut t.stroke, 0.0..=24.0)).changed();
+        ui.label("Emoji");
+        changed |= ui.add(egui::Slider::new(&mut t.emoji, 0.5..=2.0).suffix("×")).changed();
+    });
+    ui.horizontal(|ui| {
+        ui.label("Altezza");
+        changed |= ui.add(egui::Slider::new(&mut t.y, 5.0..=95.0).suffix("%")).changed();
+        ui.label("Durata");
+        ui.add(egui::Slider::new(&mut t.secs, 0.5..=15.0).suffix(" s"));
+    });
+    if changed {
+        t.preview_wanted = Some((String::new(), ctx.input(|i| i.time)));
+    }
+    let (w, h) = seq.unwrap_or((1080, 1920));
+
+    // anteprima (la disegna Jarvis, un attimo dopo che hai smesso di scrivere)
+    let now = ctx.input(|i| i.time);
+    if let Some((_, at)) = &t.preview_wanted
+        && now - at > 0.6
+        && t.preview_job.is_none()
+        && !t.text.trim().is_empty()
+    {
+        let dir = std::env::temp_dir();
+        let jp = dir.join("jarvis-title-preview.json");
+        let out = dir.join(format!("jarvis-title-preview-{}.png", (now * 1000.0) as u64));
+        let _ = std::fs::write(&jp, t.job(w / 2, h / 2).to_string());
+        t.preview_job = Some((out.to_string_lossy().to_string(), spawn(vec!["--tiktok-title".into(), jp.into(), out.clone().into()], out)));
+        t.preview_wanted = None;
+    }
+    if t.preview_wanted.is_some() {
+        ctx.request_repaint_after(std::time::Duration::from_millis(200));
+    }
+    if let Some((path, job)) = &t.preview_job {
+        let done = job.lock().ok().and_then(|mut g| g.take());
+        match done {
+            Some(Ok(_)) => {
+                if let Ok(b) = std::fs::read(path)
+                    && let Ok(img) = image::load_from_memory(&b)
+                {
+                    let rgba = img.to_rgba8();
+                    let ci = egui::ColorImage::from_rgba_unmultiplied([rgba.width() as usize, rgba.height() as usize], rgba.as_raw());
+                    t.preview = Some((path.clone(), ctx.load_texture("jarvis-title-preview", ci, egui::TextureOptions::LINEAR)));
+                }
+                let _ = std::fs::remove_file(path);
+                t.preview_job = None;
+            }
+            Some(Err(e)) => {
+                t.msg = format!("⚠ {e}");
+                t.preview_job = None;
+            }
+            None => ctx.request_repaint_after(std::time::Duration::from_millis(200)),
+        }
+    }
+    if let Some((_, tex)) = &t.preview {
+        let aw = ui.available_width().min(260.0);
+        let ah = aw * h as f32 / w as f32;
+        let (r, _) = ui.allocate_exact_size(egui::vec2(aw, ah.min(460.0)), egui::Sense::hover());
+        // sfondo a scacchi scuro come nel pannello
+        ui.painter().rect_filled(r, 6.0, egui::Color32::from_rgb(40, 40, 46));
+        let k = 12.0;
+        let mut y = r.min.y;
+        let mut row = 0;
+        while y < r.max.y {
+            let mut x = r.min.x + if row % 2 == 0 { 0.0 } else { k };
+            while x < r.max.x {
+                let c = egui::Rect::from_min_size(egui::pos2(x, y), egui::vec2(k, k)).intersect(r);
+                ui.painter().rect_filled(c, 0.0, egui::Color32::from_rgb(52, 52, 58));
+                x += 2.0 * k;
+            }
+            y += k;
+            row += 1;
+        }
+        ui.painter().image(tex.id(), r, egui::Rect::from_min_max(egui::pos2(0.0, 0.0), egui::pos2(1.0, (ah.min(460.0) / ah).min(1.0))), egui::Color32::WHITE);
+    } else if t.preview_job.is_some() {
+        ui.horizontal(|ui| {
+            ui.spinner();
+            ui.small("Preparo l'anteprima…");
+        });
+    }
+
+    // aggiungi alla timeline
+    let busy = t.add_job.is_some();
+    let b = ui.add_enabled(!busy && !t.text.trim().is_empty(), egui::Button::new(if busy { "⏳ Creo il titolo…" } else { "➕ Aggiungi alla timeline" }).min_size(egui::vec2(ui.available_width(), 30.0)));
+    if b.clicked() {
+        let base = proj
+            .as_ref()
+            .and_then(|p| std::path::Path::new(p).parent().map(|d| d.join("Titoli TikTok")))
+            .or_else(|| std::env::var_os("USERPROFILE").map(|u| std::path::PathBuf::from(u).join("Documents").join("Titoli TikTok")))
+            .unwrap_or_else(|| std::env::temp_dir().join("Titoli TikTok"));
+        let _ = std::fs::create_dir_all(&base);
+        let name: String = t.text.chars().filter(|c| c.is_alphanumeric() || *c == ' ').collect::<String>().trim().chars().take(30).collect::<String>().replace(' ', "_");
+        let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs() % 1_000_000).unwrap_or(0);
+        let out = base.join(format!("{}_{stamp}.png", if name.is_empty() { "titolo".to_string() } else { name }));
+        let jp = std::env::temp_dir().join(format!("jarvis-title-{stamp}.json"));
+        let _ = std::fs::write(&jp, t.job(w, h).to_string());
+        t.add_job = Some(spawn(vec!["--tiktok-title".into(), jp.into(), out.clone().into()], out));
+        t.msg.clear();
+    }
+    if let Some(r) = take(&t.add_job) {
+        t.add_job = None;
+        match r {
+            Ok(path) => run = Some(("jarvis.placeTitle".to_string(), json!({"path": path, "seconds": t.secs}), String::new())),
+            Err(e) => t.msg = format!("⚠ {e}"),
+        }
+    } else if t.add_job.is_some() {
+        ctx.request_repaint_after(std::time::Duration::from_millis(200));
+    }
+    ui.small("Va sulla traccia \"Titoli TikTok\" all'indicatore, grande come la sequenza. I PNG restano nella cartella \"Titoli TikTok\" accanto al progetto.");
+    if !t.msg.is_empty() {
+        ui.label(&t.msg);
+    }
+    run
+}
diff --git a/crates/ui-egui/src/jarvis_ui.rs b/crates/ui-egui/src/jarvis_ui.rs
new file mode 100644
index 0000000..261f4d4
--- /dev/null
+++ b/crates/ui-egui/src/jarvis_ui.rs
@@ -0,0 +1,958 @@
+//! Jarvis Composer: finestra con sottotitoli animati, transizioni ed effetti (FilmCraft Jarvis).
+
+use serde_json::{Value, json};
+
+use crate::FilmcraftApp;
+use filmcraft_engine::jarvis::{ANIMS, CLIP_FX, COMPOSER, CapStyle, STYLES, TRANSITIONS};
+
+pub(crate) struct State {
+    pub open: bool,
+    /// Program: 0 niente, 1 Trasforma, 2 Ritaglia
+    pub xform: u8,
+    only_sel: bool,
+    style: usize,
+    /// 0 = quante ne usa lo stile
+    words: u32,
+    upper: bool,
+    censor: bool,
+    pop: bool,
+    tab: usize,
+    anim: usize,
+    tilt: bool,
+    x: f32,
+    y: f32,
+    size: f32,
+    precise: bool,
+    retranscribe: bool,
+    scope: usize,
+    amount: f32,
+    frames: u32,
+    font: String,
+    font_ok: Option<(String, bool)>,
+    msg: String,
+    /// comando da eseguire al prossimo frame (così il messaggio "attendi" si vede prima)
+    pending: Option<(String, Value, bool)>,
+    sfx: bool,
+    sfx_gain: f32,
+    /// trascrizione in corso in background
+    cap: Option<CapRun>,
+    /// aggiornamento: controllo fatto, versione nuova (tag, url), scartato
+    upd_checked: bool,
+    upd: std::sync::Arc<std::sync::Mutex<Option<(String, String)>>>,
+    upd_dismissed: bool,
+    presets_checked: bool,
+    mh_cat: String,
+    /// transizione Composer che si sta trascinando (parametri del comando)
+    mh_drag: Option<(String, Value)>,
+    thumbs: std::collections::HashMap<std::path::PathBuf, Option<egui::TextureHandle>>,
+    titles: crate::jarvis_titles::Titles,
+}
+
+type CapResult = Result<Vec<(filmcraft_project::ItemId, filmcraft_project::Transcript)>, String>;
+
+struct CapRun {
+    handle: std::thread::JoinHandle<CapResult>,
+    prog: std::sync::Arc<std::sync::Mutex<(f32, String)>>,
+    params: Value,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            open: false,
+            xform: 0,
+            only_sel: true,
+            style: 0,
+            words: 0,
+            upper: true,
+            censor: true,
+            pop: true,
+            tab: 0,
+            anim: 0,
+            tilt: false,
+            x: 50.0,
+            y: 0.0,
+            size: 100.0,
+            precise: true,
+            retranscribe: false,
+            scope: 0,
+            amount: 1.0,
+            frames: 7,
+            font: filmcraft_engine::jarvis::DEFAULT_FONT.to_string(),
+            font_ok: None,
+            msg: String::new(),
+            pending: None,
+            sfx: false,
+            sfx_gain: -3.0,
+            cap: None,
+            upd_checked: false,
+            upd: Default::default(),
+            upd_dismissed: false,
+            presets_checked: false,
+            mh_cat: String::new(),
+            mh_drag: None,
+            thumbs: Default::default(),
+            titles: Default::default(),
+        }
+    }
+}
+
+const SCOPES: [(&str, &str); 3] = [("playhead", "Taglio vicino all'indicatore"), ("selection", "Clip selezionate"), ("all", "Tutti i tagli (V1)")];
+
+pub(crate) fn toggle(app: &mut FilmcraftApp) {
+    app.jarvis_ui.open = !app.jarvis_ui.open;
+}
+
+/// Apre Jarvis Composer su una scheda (0 Composer, 1 Sottotitoli, 2 Transizioni ed effetti).
+pub(crate) fn open_tab(app: &mut FilmcraftApp, tab: usize) {
